<http://www.zt4swe.io/o4sdlc/kb> a owl:Ontology ;
    rdfs:label "O4SDLC Knowledge Base (ABox) v1.0.0"@en ;
    dcterms:creator <http://www.zt4swe.io/agent/YusufAltunel> ;
