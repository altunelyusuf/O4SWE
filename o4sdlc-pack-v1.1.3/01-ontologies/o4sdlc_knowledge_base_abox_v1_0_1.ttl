okb:Regression_AllO4sdlcPropertiesHaveDefinition a kb:RegressionTest,
        owl:NamedIndividual ;
    rdfs:label "Every O4SDLC object/datatype property has skos:definition"@en ;
    kb:hasCheckSPARQL """PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
ASK { ?p a ?t . VALUES ?t { owl:ObjectProperty owl:DatatypeProperty }
      FILTER( CONTAINS(STR(?p),"/2025/O4SE") )
      FILTER NOT EXISTS { ?p skos:definition ?d } }""" ;
    kb:hasExpectedResult "false" ;
    kb:hasTestType "sparql_ask" ;
    prov:generatedAtTime "2026-06-05"^^xsd:date ;
