okb:Regression_CrudOpsHaveCanonicalMatch a kb:RegressionTest,
        owl:NamedIndividual ;
    rdfs:label "Every O4UCM CRUD operation skos:exactMatch a canonical O4SE op (E-CRUD)"@en ;
    kb:hasCheckSPARQL """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
ASK { ?op rdfs:subClassOf <http://www.zt4swe.io/sad/ch5#CRUDOperation> . FILTER NOT EXISTS { ?op skos:exactMatch ?c } }""" ;
    kb:hasExpectedResult "false" ;
    kb:hasTestType "sparql_ask" ;
    prov:generatedAtTime "2026-06-05"^^xsd:date ;
    prov:wasAttributedTo <http://www.zt4swe.io/agent/YusufAltunel> ;
    prov:wasGeneratedBy <http://www.zt4swe.io/activity/proposal-realization-2026-06-05> .

okb:Regression_HasDescriptionNotXsdString a kb:RegressionTest,
        owl:NamedIndividual ;
    rdfs:label "BP-D18/SD-14 guard: o4se:hasDescription does not range over xsd:string"@en ;
    kb:hasCheckSPARQL """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK { <http://www.semanticweb.org/ontologies/2025/O4SE#hasDescription> rdfs:range xsd:string }""" ;
    kb:hasExpectedResult "false" ;
    kb:hasTestType "sparql_ask" ;
