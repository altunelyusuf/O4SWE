okb:Regression_MergedO4sdlcHermitConsistent a kb:RegressionTest,
        owl:NamedIndividual ;
    rdfs:label "Merged O4SDLC corpus is HermiT-consistent (canonical OWLAPI per BP-D3)"@en ;
    kb:hasCheckSPARQL "EXTERNAL: java -cp HermiT.jar Check <merged-O4SDLC.owl> ; expect isConsistent()=true, 0 unsatisfiable classes. Per BP-D3 use direct Java HermiT/OWLAPI, never the owlready2 bridge (L(O4SDLC)-3)." ;
    kb:hasExpectedResult "consistent" ;
    kb:hasTestType "external_script" ;
    prov:generatedAtTime "2026-06-05"^^xsd:date ;
    prov:wasAttributedTo <http://www.zt4swe.io/agent/YusufAltunel> ;
    prov:wasGeneratedBy <http://www.zt4swe.io/activity/oe-compliance-remediation-2026-06-05> .

