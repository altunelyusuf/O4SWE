    dcterms:source "Software metrics: McCabe (cyclomatic complexity); Chidamber & Kemerer; SLOC; ISO/IEC 25023."@en ;
    rdfs:domain prog:LinesOfCode ;
    rdfs:range xsd:integer ;
    skos:definition "The lines-of-code count of a code unit."@en .

prog:releaseYear a owl:DatatypeProperty ;
    rdfs:label "release year"@en ;
    dcterms:source "Sebesta, Concepts of Programming Languages."@en ;
    rdfs:domain prog:ProgrammingLanguage ;
    rdfs:range xsd:integer ;
    skos:definition "The release year of a programming language."@en .

prog:usesCompilationModel a owl:ObjectProperty ;
