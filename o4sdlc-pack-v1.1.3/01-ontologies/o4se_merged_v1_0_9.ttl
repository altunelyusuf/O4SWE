    owl:versionInfo "1.0.9" ;
    prov:wasAttributedTo <http://www.zt4swe.io/agent/YusufAltunel> ;
    prov:wasGeneratedBy <http://www.zt4swe.io/activity/o4se-remediation-v1_0_1> .

data:ActiveRecord a owl:Class ;
    rdfs:label "Active Record Pattern"@en ;
    dcterms:source "Fowler, M., Patterns of Enterprise Application Architecture (Active Record, Data Mapper, Repository)."@en ;
    rdfs:subClassOf data:ORM ;
    skos:definition "An object-relational mapping pattern in which a domain object carries both data and the database-access logic for its own persistence."@en .

data:AndroidOS a owl:Class ;
    rdfs:label "Android OS"@en ;
    dcterms:source "Standard operating-systems references and vendor documentation; cf. Silberschatz, Galvin & Gagne, Operating System Concepts."@en ;
    rdfs:subClassOf data:MobileOS ;
    skos:definition "A Linux-kernel-based mobile operating system developed by Google for touchscreen devices."@en .

data:Archiving a owl:Class ;
    rdfs:label "Data Archiving"@en ;
    rdfs:subClassOf data:DataMaintenance ;
    skos:definition "Long-term data storage"@en .

data:Atomicity a owl:Class ;
    rdfs:label "Atomicity"@en ;
    dcterms:source "Haerder, T. & Reuter, A. (1983), 'Principles of Transaction-Oriented Database Recovery' (origin of ACID); cf. Gray & Reuter, Transaction Processing."@en ;
    rdfs:subClassOf data:ACID ;
    skos:definition "The transaction property guaranteeing that all operations of a transaction are completed in full or none are, leaving no partial effects."@en .

data:BASE a owl:Class ;
    rdfs:label "BASE Properties"@en ;
    dcterms:source "Grounded in the O4SE source ontology's existing rdfs:comment for this class (internal authority), normalised to genus-differentia form during O4SE v1.0.2 trust remediation. SWEBOK knowledge-area definitions additionally reflect the IEEE SWEBOK Guide."@en ;
    rdfs:comment "Basically Available, Soft state, Eventual consistency"@en ;
    skos:definition "A consistency model for distributed data systems characterised as Basically Available, Soft state, and Eventual consistency."@en .

data:BlockStorage a owl:Class ;
    rdfs:label "Block Storage"@en ;
    dcterms:source "Standard data-storage and database-systems literature (e.g., Ramakrishnan & Gehrke, Database Management Systems)."@en ;
    rdfs:subClassOf data:DataStorage ;
    skos:definition "A storage architecture that exposes data as fixed-size raw blocks addressed individually, typically presented to systems as volumes."@en .

data:CAP a owl:Class ;
    rdfs:label "CAP Theorem"@en ;
    dcterms:source "Grounded in the O4SE source ontology's existing rdfs:comment for this class (internal authority), normalised to genus-differentia form during O4SE v1.0.2 trust remediation. SWEBOK knowledge-area definitions additionally reflect the IEEE SWEBOK Guide."@en ;
    rdfs:comment "Consistency, Availability, Partition tolerance"@en ;
    skos:definition "The set of three guarantees of a distributed data system — Consistency, Availability, and Partition tolerance — of which the CAP theorem permits at most two simultaneously."@en .

data:Cassandra a data:ColumnFamilyDatabase ;
    rdfs:label "Apache Cassandra"@en .

data:CloudStorage a owl:Class ;
    rdfs:label "Cloud Storage"@en ;
    dcterms:source "NIST SP 800-145, The NIST Definition of Cloud Computing (2011). Verified 2026-06-05."@en ;
    rdfs:subClassOf data:DataStorage ;
    skos:definition "A model in which data is stored on remote, provider-managed infrastructure and accessed over a network on demand."@en .

data:Consistency a owl:Class ;
    rdfs:label "Consistency"@en ;
    dcterms:source "Haerder, T. & Reuter, A. (1983), 'Principles of Transaction-Oriented Database Recovery' (origin of ACID); cf. Gray & Reuter, Transaction Processing."@en ;
    rdfs:subClassOf data:ACID ;
    skos:definition "The transaction property guaranteeing that a transaction moves the database from one valid state to another, preserving all defined integrity rules."@en .

data:Constraint a owl:Class ;
    rdfs:label "Database Constraint"@en ;
    dcterms:source "Grounded in the O4SE source ontology's existing rdfs:comment for this class (internal authority), normalised to genus-differentia form during O4SE v1.0.2 trust remediation. SWEBOK knowledge-area definitions additionally reflect the IEEE SWEBOK Guide."@en ;
    rdfs:comment "Rule enforced on data"@en ;
    skos:definition "A rule enforced on data to preserve its validity or integrity."@en .

data:CouchDB a data:DocumentDatabase ;
    rdfs:label "CouchDB"@en .

data:CreateOperation a owl:Class ;
    rdfs:label "Create Operation"@en ;
    rdfs:subClassOf data:DataOperation ;
    skos:definition "Insert new data"@en .

data:CypherQuery a owl:Class ;
    rdfs:label "Cypher Query"@en ;
    rdfs:subClassOf data:QueryLanguage ;
    skos:definition "Query language for graph databases"@en .

data:DBMS a owl:Class ;
    rdfs:label "Database Management System"@en ;
    rdfs:subClassOf data:DatabaseSystem ;
    skos:definition "Software for creating and managing databases"@en .

data:DataAccuracy a owl:Class ;
    rdfs:label "Data Accuracy"@en ;
    dcterms:source "DAMA International, Data Management Body of Knowledge (DAMA-DMBOK) — data-quality dimensions."@en ;
    rdfs:subClassOf data:DataQuality ;
    skos:definition "A data-quality dimension measuring the degree to which data correctly describes the real-world object or event it represents."@en .

data:DataCompleteness a owl:Class ;
    rdfs:label "Data Completeness"@en ;
    dcterms:source "DAMA International, Data Management Body of Knowledge (DAMA-DMBOK) — data-quality dimensions."@en ;
    rdfs:subClassOf data:DataQuality ;
    skos:definition "A data-quality dimension measuring the degree to which all required data is present."@en .

data:DataConsistency a owl:Class ;
    rdfs:label "Data Consistency"@en ;
    dcterms:source "DAMA International, Data Management Body of Knowledge (DAMA-DMBOK) — data-quality dimensions."@en ;
    rdfs:subClassOf data:DataQuality ;
    skos:definition "A data-quality dimension measuring the absence of contradiction between data values across records, systems, or time."@en .

data:DataIntegrity a owl:Class ;
    rdfs:label "Data Integrity"@en ;
    dcterms:source "DAMA International, Data Management Body of Knowledge (DAMA-DMBOK) — data-quality dimensions."@en ;
    rdfs:subClassOf data:DataQuality ;
    skos:definition "The maintenance and assurance of the accuracy and consistency of data over its entire lifecycle, including referential and entity integrity."@en .

data:DataLake a owl:Class ;
    rdfs:label "Data Lake"@en ;
    rdfs:subClassOf data:DataStorage ;
    skos:definition "Repository for raw data"@en .

data:DataMapper a owl:Class ;
    rdfs:label "Data Mapper Pattern"@en ;
    dcterms:source "Fowler, M., Patterns of Enterprise Application Architecture (Active Record, Data Mapper, Repository)."@en ;
    rdfs:subClassOf data:ORM ;
    skos:definition "An object-relational mapping pattern in which a separate mapper layer transfers data between objects and the database, keeping them independent of each other."@en .

data:DataMart a owl:Class ;
    rdfs:label "Data Mart"@en ;
    rdfs:subClassOf data:DataStorage ;
    skos:definition "Subset of data warehouse"@en .

data:DataMigration a owl:Class ;
    rdfs:label "Data Migration"@en ;
    dcterms:source "DAMA International, Data Management Body of Knowledge (DAMA-DMBOK) — data-quality dimensions."@en ;
    rdfs:subClassOf data:Migration ;
    skos:definition "The process of transferring data between storage systems, formats, or schemas."@en .

data:DataModel a owl:Class ;
    rdfs:label "Data Model"@en ;
    dcterms:source "Grounded in the O4SE source ontology's existing rdfs:comment for this class (internal authority), normalised to genus-differentia form during O4SE v1.0.2 trust remediation. SWEBOK knowledge-area definitions additionally reflect the IEEE SWEBOK Guide."@en ;
    rdfs:comment "Abstract model organizing data elements"@en ;
    skos:definition "An abstract model that organises data elements and standardises how they relate to one another."@en .

data:DataTimeliness a owl:Class ;
    rdfs:label "Data Timeliness"@en ;
    dcterms:source "DAMA International, Data Management Body of Knowledge (DAMA-DMBOK) — data-quality dimensions."@en ;
    rdfs:subClassOf data:DataQuality ;
    skos:definition "A data-quality dimension measuring the degree to which data is sufficiently up to date for the task at hand."@en .

data:DataValidity a owl:Class ;
    rdfs:label "Data Validity"@en ;
    dcterms:source "DAMA International, Data Management Body of Knowledge (DAMA-DMBOK) — data-quality dimensions."@en ;
    rdfs:subClassOf data:DataQuality ;
    skos:definition "A data-quality dimension measuring the degree to which data conforms to its defined format, type, and range constraints."@en .

data:DataWarehouse a owl:Class ;
    rdfs:label "Data Warehouse"@en ;
    rdfs:subClassOf data:DataStorage ;
    skos:definition "Central repository for analytics"@en .

data:DeleteOperation a owl:Class ;
    rdfs:label "Delete Operation"@en ;
    rdfs:subClassOf data:DataOperation ;
    skos:definition "Remove existing data"@en .

data:DifferentialBackup a owl:Class ;
    rdfs:label "Differential Backup"@en ;
    dcterms:source "Standard backup-strategy practice (full/incremental/differential)."@en ;
    rdfs:subClassOf data:Backup ;
    skos:definition "A backup strategy that copies all data changed since the last full backup."@en .

data:DistributedDatabase a owl:Class ;
    rdfs:label "Distributed Database"@en ;
    rdfs:subClassOf data:Database ;
    skos:definition "Data distributed across multiple nodes"@en .

data:Durability a owl:Class ;
    rdfs:label "Durability"@en ;
    dcterms:source "Haerder, T. & Reuter, A. (1983), 'Principles of Transaction-Oriented Database Recovery' (origin of ACID); cf. Gray & Reuter, Transaction Processing."@en ;
    rdfs:subClassOf data:ACID ;
    skos:definition "The transaction property guaranteeing that once a transaction commits, its effects persist even in the event of system failure."@en .

data:DynamoDB a data:NoSQLDatabase ;
    rdfs:label "Amazon DynamoDB"@en .

data:FileStorage a owl:Class ;
    rdfs:label "File Storage"@en ;
    dcterms:source "Standard data-storage and database-systems literature (e.g., Ramakrishnan & Gehrke, Database Management Systems)."@en ;
    rdfs:subClassOf data:DataStorage ;
    skos:definition "A storage architecture that organises data as files within a hierarchical directory structure accessed by file path."@en .

data:FileSystem a owl:Class ;
    rdfs:label "File System"@en ;
    dcterms:source "Grounded in the O4SE source ontology's existing rdfs:comment for this class (internal authority), normalised to genus-differentia form during O4SE v1.0.2 trust remediation. SWEBOK knowledge-area definitions additionally reflect the IEEE SWEBOK Guide."@en ;
    rdfs:comment "Method of storing files"@en ;
    skos:definition "A method and set of structures by which an operating system stores, names, and retrieves files."@en .

data:ForeignKey a owl:Class ;
    rdfs:label "Foreign Key"@en ;
    dcterms:source "Grounded in the O4SE source ontology's existing rdfs:comment for this class (internal authority), normalised to genus-differentia form during O4SE v1.0.2 trust remediation. SWEBOK knowledge-area definitions additionally reflect the IEEE SWEBOK Guide."@en ;
    rdfs:comment "Reference to another table"@en ;
    skos:definition "A data constraint that is a reference from one table to the primary key of another, enforcing referential integrity."@en .

data:FullBackup a owl:Class ;
    rdfs:label "Full Backup"@en ;
    dcterms:source "Standard backup-strategy practice (full/incremental/differential)."@en ;
    rdfs:subClassOf data:Backup ;
    skos:definition "A backup strategy that copies all selected data in its entirety at each backup operation."@en .

data:GraphQL a owl:Class ;
    rdfs:label "GraphQL"@en ;
    rdfs:subClassOf data:QueryLanguage ;
    skos:definition "Query language for APIs"@en .

data:InMemoryDatabase a owl:Class ;
    rdfs:label "In-Memory Database"@en ;
    rdfs:subClassOf data:Database ;
    skos:definition "Data stored in main memory"@en .

data:IncrementalBackup a owl:Class ;
    rdfs:label "Incremental Backup"@en ;
    dcterms:source "Standard backup-strategy practice (full/incremental/differential)."@en ;
    rdfs:subClassOf data:Backup ;
    skos:definition "A backup strategy that copies only the data changed since the most recent backup of any type."@en .

data:Index a owl:Class ;
    rdfs:label "Database Index"@en ;
    dcterms:source "Grounded in the O4SE source ontology's existing rdfs:comment for this class (internal authority), normalised to genus-differentia form during O4SE v1.0.2 trust remediation. SWEBOK knowledge-area definitions additionally reflect the IEEE SWEBOK Guide."@en ;
    rdfs:comment "Data structure for faster retrieval"@en ;
    skos:definition "A data structure that improves the speed of data retrieval from a table at the cost of additional storage and maintenance."@en .

data:InfluxDB a data:TimeSeriesDatabase ;
    rdfs:label "InfluxDB"@en .

data:Isolation a owl:Class ;
    rdfs:label "Isolation"@en ;
    dcterms:source "Haerder, T. & Reuter, A. (1983), 'Principles of Transaction-Oriented Database Recovery' (origin of ACID); cf. Gray & Reuter, Transaction Processing."@en ;
    rdfs:subClassOf data:ACID ;
    skos:definition "The transaction property guaranteeing that concurrently executing transactions produce a result equivalent to some serial execution."@en .

data:Kernel a owl:Class ;
    rdfs:label "OS Kernel"@en ;
    dcterms:source "Grounded in the O4SE source ontology's existing rdfs:comment for this class (internal authority), normalised to genus-differentia form during O4SE v1.0.2 trust remediation. SWEBOK knowledge-area definitions additionally reflect the IEEE SWEBOK Guide."@en ;
    rdfs:comment "Core of operating system"@en ;
    skos:definition "The core component of an operating system that manages system resources and mediates access between hardware and software."@en .

data:LinuxOS a owl:Class ;
    rdfs:label "Linux OS"@en ;
    dcterms:source "Standard operating-systems references and vendor documentation; cf. Silberschatz, Galvin & Gagne, Operating System Concepts."@en ;
    rdfs:subClassOf data:OperatingSystem ;
    skos:definition "A Unix-like, open-source operating system built around the Linux kernel."@en .

data:MacOS a owl:Class ;
    rdfs:label "macOS"@en ;
    dcterms:source "Standard operating-systems references and vendor documentation; cf. Silberschatz, Galvin & Gagne, Operating System Concepts."@en ;
    rdfs:subClassOf data:OperatingSystem ;
    skos:definition "A Unix-based proprietary operating system developed by Apple for Macintosh computers."@en .

data:MasterMasterReplication a owl:Class ;
    rdfs:label "Master-Master Replication"@en ;
    dcterms:source "Standard database-replication patterns (primary-replica / multi-primary)."@en ;
    rdfs:subClassOf data:Replication ;
    skos:definition "A database replication topology in which multiple primary nodes each accept writes and synchronise changes among one another."@en .

data:MasterSlaveReplication a owl:Class ;
    rdfs:label "Master-Slave Replication"@en ;
    dcterms:source "Standard database-replication patterns (primary-replica / multi-primary)."@en ;
    rdfs:subClassOf data:Replication ;
    skos:definition "A database replication topology in which a single primary (master) node accepts writes and propagates changes to one or more read-only replica (slave) nodes."@en .

data:MemoryManagement a owl:Class ;
    rdfs:label "Memory Management"@en ;
    dcterms:source "Grounded in the O4SE source ontology's existing rdfs:comment for this class (internal authority), normalised to genus-differentia form during O4SE v1.0.2 trust remediation. SWEBOK knowledge-area definitions additionally reflect the IEEE SWEBOK Guide."@en ;
    rdfs:comment "Managing system memory"@en ;
    skos:definition "The operating-system function of allocating, tracking, and reclaiming system memory among processes."@en .

data:MongoDB a data:DocumentDatabase ;
    rdfs:label "MongoDB"@en .

data:MySQL a data:SQLDatabase ;
    rdfs:label "MySQL"@en .

data:Neo4j a data:GraphDatabase ;
    rdfs:label "Neo4j"@en .

data:NewSQLDatabase a owl:Class ;
    rdfs:label "NewSQL Database"@en ;
    rdfs:subClassOf data:Database ;
    skos:definition "Modern relational with NoSQL scalability"@en .

data:NoSQLQuery a owl:Class ;
    rdfs:label "NoSQL Query"@en ;
    dcterms:source "Standard data-storage and database-systems literature (e.g., Ramakrishnan & Gehrke, Database Management Systems)."@en ;
    rdfs:subClassOf data:QueryLanguage ;
    skos:definition "A query expressed against a non-relational (NoSQL) data store, using the store's native access model rather than SQL."@en .

data:ODM a owl:Class ;
    rdfs:label "Object-Document Mapping"@en ;
    rdfs:subClassOf data:ObjectMapping ;
    skos:definition "Maps objects to document database"@en .

data:ObjectDatabase a owl:Class ;
    rdfs:label "Object Database"@en ;
    rdfs:subClassOf data:Database ;
    skos:definition "Stores data as objects"@en .

data:ObjectStorage a owl:Class ;
    rdfs:label "Object Storage"@en ;
    dcterms:source "Standard data-storage and database-systems literature (e.g., Ramakrishnan & Gehrke, Database Management Systems)."@en ;
    rdfs:subClassOf data:DataStorage ;
    skos:definition "A storage architecture that manages data as discrete objects, each with data, metadata, and a unique identifier, within a flat address space."@en .

data:Oracle a data:SQLDatabase ;
    rdfs:label "Oracle Database"@en .

data:Partitioning a owl:Class ;
    rdfs:label "Data Partitioning"@en ;
    dcterms:source "Standard data-storage and database-systems literature (e.g., Ramakrishnan & Gehrke, Database Management Systems)."@en ;
    rdfs:subClassOf data:DataMaintenance ;
    skos:definition "The division of a database or dataset into distinct segments (partitions or shards) to improve manageability, performance, or scalability."@en .

data:PostgreSQL a data:SQLDatabase ;
    rdfs:label "PostgreSQL"@en .

data:PrimaryKey a owl:Class ;
    rdfs:label "Primary Key"@en ;
    dcterms:source "Grounded in the O4SE source ontology's existing rdfs:comment for this class (internal authority), normalised to genus-differentia form during O4SE v1.0.2 trust remediation. SWEBOK knowledge-area definitions additionally reflect the IEEE SWEBOK Guide."@en ;
    rdfs:comment "Unique identifier for records"@en ;
    skos:definition "A data constraint that uniquely identifies each record in a table."@en .

data:ProcessManagement a owl:Class ;
    rdfs:label "Process Management"@en ;
    dcterms:source "Grounded in the O4SE source ontology's existing rdfs:comment for this class (internal authority), normalised to genus-differentia form during O4SE v1.0.2 trust remediation. SWEBOK knowledge-area definitions additionally reflect the IEEE SWEBOK Guide."@en ;
    rdfs:comment "Managing running processes"@en ;
    skos:definition "The operating-system function of creating, scheduling, and terminating running processes."@en .

data:RTOS a owl:Class ;
    rdfs:label "Real-Time OS"@en ;
    dcterms:source "Standard operating-systems references and vendor documentation; cf. Silberschatz, Galvin & Gagne, Operating System Concepts."@en ;
    rdfs:subClassOf data:OperatingSystem ;
    skos:definition "A real-time operating system that guarantees response within defined time constraints, used in time-critical embedded systems."@en .

data:ReadOperation a owl:Class ;
    rdfs:label "Read Operation"@en ;
    rdfs:subClassOf data:DataOperation ;
    skos:definition "Retrieve existing data"@en .

data:Recovery a owl:Class ;
    rdfs:label "Database Recovery"@en ;
    rdfs:subClassOf data:DataMaintenance ;
    skos:definition "Restoring database after failure"@en .

data:Redis a data:KeyValueDatabase ;
    rdfs:label "Redis"@en .

data:Repository a owl:Class ;
    rdfs:label "Repository Pattern"@en ;
    dcterms:source "Fowler, M., Patterns of Enterprise Application Architecture (Active Record, Data Mapper, Repository)."@en ;
    rdfs:subClassOf data:ObjectMapping ;
    skos:definition "A pattern that mediates between the domain and data-mapping layers, providing a collection-like interface for accessing domain objects."@en .

data:SPARQL a owl:Class ;
    rdfs:label "SPARQL"@en ;
    rdfs:subClassOf data:QueryLanguage ;
    skos:definition "Query language for RDF data"@en .

data:SQL a owl:Class ;
    rdfs:label "Structured Query Language"@en ;
    rdfs:subClassOf data:QueryLanguage ;
    skos:definition "Standard language for relational databases"@en .

data:SQLServer a data:SQLDatabase ;
    rdfs:label "Microsoft SQL Server"@en .

data:SQLite a data:SQLDatabase ;
    rdfs:label "SQLite"@en .

data:SchemaMigration a owl:Class ;
    rdfs:label "Schema Migration"@en ;
    dcterms:source "Standard data-storage and database-systems literature (e.g., Ramakrishnan & Gehrke, Database Management Systems)."@en ;
    rdfs:subClassOf data:Migration ;
    skos:definition "The controlled, versioned evolution of a database schema while preserving existing data."@en .

data:Sharding a owl:Class ;
    rdfs:label "Database Sharding"@en ;
    rdfs:subClassOf data:DataMaintenance ;
    skos:definition "Horizontal partitioning of data"@en .

data:StoredProcedure a owl:Class ;
    rdfs:label "Stored Procedure"@en ;
    dcterms:source "Grounded in the O4SE source ontology's existing rdfs:comment for this class (internal authority), normalised to genus-differentia form during O4SE v1.0.2 trust remediation. SWEBOK knowledge-area definitions additionally reflect the IEEE SWEBOK Guide."@en ;
    rdfs:comment "Precompiled database program"@en ;
    skos:definition "A precompiled program stored in and executed by a database management system."@en .

data:SystemCall a owl:Class ;
    rdfs:label "System Call"@en ;
    dcterms:source "Grounded in the O4SE source ontology's existing rdfs:comment for this class (internal authority), normalised to genus-differentia form during O4SE v1.0.2 trust remediation. SWEBOK knowledge-area definitions additionally reflect the IEEE SWEBOK Guide."@en ;
    rdfs:comment "Request to OS kernel"@en ;
    skos:definition "A request issued by a program to the operating-system kernel for a privileged service."@en .

data:Trigger a owl:Class ;
    rdfs:label "Database Trigger"@en ;
    dcterms:source "Grounded in the O4SE source ontology's existing rdfs:comment for this class (internal authority), normalised to genus-differentia form during O4SE v1.0.2 trust remediation. SWEBOK knowledge-area definitions additionally reflect the IEEE SWEBOK Guide."@en ;
    rdfs:comment "Automatic action on data change"@en ;
    skos:definition "A database mechanism that automatically executes a defined action in response to a specified data-change event."@en .

data:UnixOS a owl:Class ;
    rdfs:label "Unix OS"@en ;
    dcterms:source "Standard operating-systems references and vendor documentation; cf. Silberschatz, Galvin & Gagne, Operating System Concepts."@en ;
    rdfs:subClassOf data:OperatingSystem ;
    skos:definition "A family of multitasking, multiuser operating systems derived from the original AT&T Unix."@en .

data:UpdateOperation a owl:Class ;
    rdfs:label "Update Operation"@en ;
    rdfs:subClassOf data:DataOperation ;
    skos:definition "Modify existing data"@en .

data:View a owl:Class ;
    rdfs:label "Database View"@en ;
    dcterms:source "Grounded in the O4SE source ontology's existing rdfs:comment for this class (internal authority), normalised to genus-differentia form during O4SE v1.0.2 trust remediation. SWEBOK knowledge-area definitions additionally reflect the IEEE SWEBOK Guide."@en ;
    rdfs:comment "Virtual table from query"@en ;
    skos:definition "A virtual table whose contents are defined by a stored query over one or more base tables."@en .

data:WindowsOS a owl:Class ;
    rdfs:label "Windows OS"@en ;
    dcterms:source "Standard operating-systems references and vendor documentation; cf. Silberschatz, Galvin & Gagne, Operating System Concepts."@en ;
    rdfs:subClassOf data:OperatingSystem ;
    skos:definition "A family of proprietary graphical operating systems developed by Microsoft."@en .

data:backupFrequency a owl:DatatypeProperty ;
    rdfs:label "backup frequency"@en ;
    dcterms:source "Standard database-systems literature (Ramakrishnan & Gehrke); cf. DAMA-DMBOK."@en ;
    rdfs:domain data:Backup ;
    rdfs:range xsd:string ;
    skos:definition "How frequently a backup is performed."@en .

data:databaseSize a owl:DatatypeProperty ;
    rdfs:label "database size"@en ;
    dcterms:source "Standard database-systems literature (Ramakrishnan & Gehrke); cf. DAMA-DMBOK."@en ;
    rdfs:domain data:Database ;
    rdfs:range xsd:string ;
    skos:definition "The size of a database, recorded as a literal."@en .

data:hasBackupStrategy a owl:ObjectProperty ;
    rdfs:label "has backup strategy"@en ;
    dcterms:source "Standard database-systems literature (Ramakrishnan & Gehrke); cf. DAMA-DMBOK."@en ;
    rdfs:domain data:Database ;
    rdfs:range data:Backup ;
    skos:definition "Relates a database to its backup strategy."@en .

data:hasSchema a owl:ObjectProperty ;
    rdfs:label "has schema"@en ;
    dcterms:source "Standard database-systems literature (Ramakrishnan & Gehrke); cf. DAMA-DMBOK."@en ;
    rdfs:domain data:Database ;
    rdfs:range data:Schema ;
    skos:definition "Relates a database to its schema."@en .

data:hasTransaction a owl:ObjectProperty ;
    rdfs:label "has transaction"@en ;
    dcterms:source "Haerder & Reuter (1983), ACID transaction properties."@en ;
    rdfs:domain data:Database ;
    rdfs:range data:Transaction ;
    skos:definition "Relates a database to a transaction it processes."@en .

data:iOS a owl:Class ;
    rdfs:label "iOS"@en ;
    dcterms:source "Standard operating-systems references and vendor documentation; cf. Silberschatz, Galvin & Gagne, Operating System Concepts."@en ;
    rdfs:subClassOf data:MobileOS ;
    skos:definition "A proprietary mobile operating system developed by Apple for its iPhone and related devices."@en .

data:performsOperation a owl:ObjectProperty ;
    rdfs:label "performs operation"@en ;
    dcterms:source "Standard database-systems literature (Ramakrishnan & Gehrke); cf. DAMA-DMBOK."@en ;
    rdfs:domain o4se:Software ;
    rdfs:range data:DataOperation ;
    skos:definition "Relates software to a data operation it performs."@en .

data:queryPerformance a owl:DatatypeProperty ;
    rdfs:label "query performance"@en ;
    dcterms:source "Standard database-systems literature (Ramakrishnan & Gehrke); cf. DAMA-DMBOK."@en ;
    rdfs:comment "Range relaxed xsd:duration->xsd:string for OWL 2 DL (DRIFT-19); value is an ISO-8601 duration lexical string (e.g. 'P2D')."@en ;
    rdfs:domain data:Database ;
    rdfs:range xsd:string ;
    skos:definition "The query-performance characteristic of a database (range relaxed to xsd:string per DRIFT-19)."@en .

data:recordCount a owl:DatatypeProperty ;
    rdfs:label "record count"@en ;
    dcterms:source "Standard database-systems literature (Ramakrishnan & Gehrke); cf. DAMA-DMBOK."@en ;
    rdfs:domain data:Database ;
    rdfs:range xsd:integer ;
    skos:definition "The number of records in a database."@en .

data:replicationFactor a owl:DatatypeProperty ;
    rdfs:label "replication factor"@en ;
    dcterms:source "Standard database-systems literature (Ramakrishnan & Gehrke); cf. DAMA-DMBOK."@en ;
    rdfs:domain data:Replication ;
    rdfs:range xsd:integer ;
    skos:definition "The replication factor (number of copies) of a replication scheme."@en .

data:runsOnOS a owl:ObjectProperty ;
    rdfs:label "runs on OS"@en ;
    dcterms:source "Operating-systems references (Silberschatz, Galvin & Gagne)."@en ;
    rdfs:domain o4se:Software ;
    rdfs:range data:OperatingSystem ;
    skos:definition "Relates software to the operating system on which it runs."@en .

data:supportsConcept a owl:ObjectProperty ;
    rdfs:label "supports concept"@en ;
    dcterms:source "Haerder & Reuter (1983), ACID transaction properties."@en ;
    rdfs:domain data:Database ;
    rdfs:range data:ACID ;
    skos:definition "Relates a database to an ACID property it supports."@en .

data:usesDatabase a owl:ObjectProperty ;
    rdfs:label "uses database"@en ;
    dcterms:source "Standard database-systems literature (Ramakrishnan & Gehrke); cf. DAMA-DMBOK."@en ;
    rdfs:domain o4se:SoftwareSystem ;
    rdfs:range data:Database ;
    skos:definition "Relates a software system to a database it uses."@en .

data:usesORM a owl:ObjectProperty ;
    rdfs:label "uses ORM"@en ;
    dcterms:source "Fowler, Patterns of Enterprise Application Architecture."@en ;
    rdfs:domain o4se:Software ;
    rdfs:range data:ORM ;
    skos:definition "Relates software to an object-relational mapping it uses."@en .

data:usesQueryLanguage a owl:ObjectProperty ;
