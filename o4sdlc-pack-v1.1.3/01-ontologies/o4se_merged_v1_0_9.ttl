@prefix arch: <http://www.semanticweb.org/ontologies/2025/O4SE/Architectures#> .
@prefix cmmi: <http://www.semanticweb.org/ontologies/2025/O4SE/CMMI#> .
@prefix data: <http://www.semanticweb.org/ontologies/2025/O4SE/DataManagement#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix method: <http://www.semanticweb.org/ontologies/2025/O4SE/Methodologies#> .
@prefix o4se: <http://www.semanticweb.org/ontologies/2025/O4SE#> .
@prefix org1: <http://www.semanticweb.org/ontologies/2025/O4SE/Organizations#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prog: <http://www.semanticweb.org/ontologies/2025/O4SE/ProgrammingLanguages#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix swebok: <http://www.semanticweb.org/ontologies/2025/O4SE/SWEBOK#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

o4se:Analysis a owl:Class ;
    rdfs:label "Analysis"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017, Systems and software engineering — Vocabulary (SEVOCAB). Verified 2026-06-05."@en ;
    rdfs:subClassOf o4se:Activity ;
    skos:definition "A software-engineering activity that examines and models a problem domain and requirements to determine what a system must do."@en .

o4se:Architect a owl:Class ;
    rdfs:label "Software Architect"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017, Systems and software engineering — Vocabulary (SEVOCAB). Verified 2026-06-05."@en ;
    rdfs:subClassOf o4se:Stakeholder ;
    skos:definition "A stakeholder responsible for defining and maintaining the architecture of a system."@en .

o4se:ContinuousIntegration a o4se:DevOpsMethodology ;
    rdfs:label "Continuous Integration"@en ;
    o4se:hasDescription "Practice of merging developer working copies to a shared mainline several times a day"@en .

o4se:Customer a owl:Class ;
    rdfs:label "Customer"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017, Systems and software engineering — Vocabulary (SEVOCAB). Verified 2026-06-05."@en ;
    rdfs:subClassOf o4se:Stakeholder ;
    skos:definition "A stakeholder who commissions, acquires, or pays for a software system."@en .

o4se:Deployment a owl:Class ;
    rdfs:label "Deployment"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, Systems and software engineering — Software life cycle processes."@en ;
    rdfs:subClassOf o4se:Activity ;
    skos:definition "A software-engineering activity that delivers and installs a software system into its operational environment."@en .

o4se:DeploymentPhase a owl:Class ;
    rdfs:label "Deployment Phase"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, Systems and software engineering — Software life cycle processes."@en ;
    rdfs:subClassOf o4se:LifecyclePhase ;
    skos:definition "The lifecycle phase during which a system is released, installed, and made operational."@en .

o4se:DesignPhase a owl:Class ;
    rdfs:label "Design Phase"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, Systems and software engineering — Software life cycle processes."@en ;
    rdfs:subClassOf o4se:LifecyclePhase ;
    skos:definition "The lifecycle phase during which the software design is produced."@en .

o4se:Developer a owl:Class ;
    rdfs:label "Developer"@en ;
    dcterms:source "Grounded in the O4SE source ontology's existing rdfs:comment for this class (internal authority), normalised to genus-differentia form during O4SE v1.0.2 trust remediation. SWEBOK knowledge-area definitions additionally reflect the IEEE SWEBOK Guide."@en ;
    rdfs:comment "A person who designs, codes, and tests software"@en ;
    rdfs:subClassOf o4se:Stakeholder ;
    skos:definition "A stakeholder who is a person responsible for designing, coding, and testing software."@en .

o4se:DevelopmentProcess a owl:Class ;
    rdfs:label "Development Process"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, Systems and software engineering — Software life cycle processes."@en ;
    rdfs:subClassOf o4se:SoftwareProcess ;
    skos:definition "A software process comprising the activities that produce a software product from requirements to a working system."@en .

o4se:Documentation a owl:Class ;
    rdfs:label "Documentation"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017, Systems and software engineering — Vocabulary (SEVOCAB). Verified 2026-06-05."@en ;
    rdfs:subClassOf o4se:Artifact ;
    skos:definition "An artifact comprising recorded information that describes a system, its development, or its use."@en .

o4se:EmbeddedSoftware a owl:Class ;
    rdfs:label "Embedded Software"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017, Systems and software engineering — Vocabulary (SEVOCAB). Verified 2026-06-05."@en ;
    rdfs:subClassOf o4se:Software ;
    skos:definition "Software that is an integral part of a hardware device and controls its functions."@en .

o4se:FunctionalRequirement a owl:Class ;
    rdfs:label "Functional Requirement"@en ;
    dcterms:source "ISO/IEC/IEEE 29148:2018 Requirements engineering; cross-referenced ISO/IEC/IEEE 24765:2017 (SEVOCAB). Verified 2026-06-05."@en ;
    rdfs:subClassOf o4se:Requirement ;
    skos:definition "A requirement that specifies a function or behaviour that a system or system component must perform."@en .

o4se:ImplementationPhase a owl:Class ;
    rdfs:label "Implementation Phase"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, Systems and software engineering — Software life cycle processes."@en ;
    rdfs:subClassOf o4se:LifecyclePhase ;
    skos:definition "The lifecycle phase during which software is coded and built."@en .

o4se:Maintainability a owl:Class ;
    rdfs:label "Maintainability"@en ;
    dcterms:source "ISO/IEC 25010:2023, Systems and software Quality Requirements and Evaluation (SQuaRE) — product quality model (iso25000.com). Verified 2026-06-05."@en ;
    rdfs:subClassOf o4se:QualityAttribute ;
    skos:definition "The degree to which a software product can be effectively and efficiently modified to correct, improve, or adapt it — comprising modularity, reusability, analysability, modifiability, and testability."@en .

o4se:MaintenancePhase a owl:Class ;
    rdfs:label "Maintenance Phase"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, Systems and software engineering — Software life cycle processes."@en ;
    rdfs:subClassOf o4se:LifecyclePhase ;
    skos:definition "The lifecycle phase during which a delivered software product is maintained."@en .

o4se:ManagementTool a owl:Class ;
    rdfs:label "Management Tool"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017, Systems and software engineering — Vocabulary (SEVOCAB). Verified 2026-06-05."@en ;
    rdfs:subClassOf o4se:Tool ;
    skos:definition "A tool used to support the planning, tracking, and control of software work."@en .

o4se:Performance a owl:Class ;
    rdfs:label "Performance"@en ;
    dcterms:source "ISO/IEC 25010:2023, Systems and software Quality Requirements and Evaluation (SQuaRE) — product quality model (iso25000.com). Verified 2026-06-05."@en ;
    rdfs:subClassOf o4se:QualityAttribute ;
    skos:definition "The performance of a software product relative to the amount of resources used under stated conditions — comprising time behaviour, resource utilisation, and capacity (ISO/IEC 25010 performance efficiency)."@en .

o4se:ProjectManager a owl:Class ;
    rdfs:label "Project Manager"@en ;
    dcterms:source "PMI PMBOK Guide; cross-referenced ISO/IEC/IEEE 24765."@en ;
    rdfs:subClassOf o4se:Stakeholder ;
    skos:definition "A stakeholder responsible for planning, executing, monitoring, and controlling a software project."@en .

o4se:Reliability a owl:Class ;
    rdfs:label "Reliability"@en ;
    dcterms:source "ISO/IEC 25010:2023, Systems and software Quality Requirements and Evaluation (SQuaRE) — product quality model (iso25000.com). Verified 2026-06-05."@en ;
    rdfs:subClassOf o4se:QualityAttribute ;
    skos:definition "The degree to which a software product performs specified functions under specified conditions for a specified period — comprising maturity, availability, fault tolerance, and recoverability."@en .

o4se:RequirementsPhase a owl:Class ;
    rdfs:label "Requirements Phase"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, Systems and software engineering — Software life cycle processes."@en ;
    rdfs:subClassOf o4se:LifecyclePhase ;
    skos:definition "The lifecycle phase during which software requirements are elicited, analysed, specified, and validated."@en .

o4se:Scalability a owl:Class ;
    rdfs:label "Scalability"@en ;
    dcterms:source "ISO/IEC 25010:2023, Systems and software Quality Requirements and Evaluation (SQuaRE) — product quality model (iso25000.com). Verified 2026-06-05."@en ;
    rdfs:subClassOf o4se:QualityAttribute ;
    skos:definition "A quality attribute denoting a system's capacity to handle increasing workload by adding resources; in ISO/IEC 25010 it corresponds to the Capacity sub-characteristic of performance efficiency."@en .

o4se:ScrumFramework a o4se:AgileMethodology ;
    rdfs:label "Scrum Framework"@en ;
    o4se:hasDescription "Iterative and incremental agile software development framework"@en .

o4se:Security a owl:Class ;
    rdfs:label "Security"@en ;
    dcterms:source "ISO/IEC 25010:2023, Systems and software Quality Requirements and Evaluation (SQuaRE) — product quality model (iso25000.com). Verified 2026-06-05."@en ;
    rdfs:subClassOf o4se:QualityAttribute ;
    skos:definition "The degree to which a software product protects information and data so that appropriate access is enforced — comprising confidentiality, integrity, non-repudiation, accountability, and authenticity."@en .

o4se:Tester a owl:Class ;
    rdfs:label "Tester"@en ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing; cross-referenced ISO/IEC/IEEE 24765."@en ;
    rdfs:subClassOf o4se:Stakeholder ;
    skos:definition "A stakeholder responsible for designing and executing software tests."@en .

o4se:TestingPhase a owl:Class ;
    rdfs:label "Testing Phase"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, Systems and software engineering — Software life cycle processes."@en ;
    rdfs:subClassOf o4se:LifecyclePhase ;
    skos:definition "The lifecycle phase during which software is tested."@en .

o4se:TestingTool a owl:Class ;
    rdfs:label "Testing Tool"@en ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing; cross-referenced ISO/IEC/IEEE 24765."@en ;
    rdfs:subClassOf o4se:Tool ;
    skos:definition "A tool used to support software testing activities."@en .

o4se:Usability a owl:Class ;
    rdfs:label "Usability"@en ;
    dcterms:source "ISO/IEC 25010:2023, Systems and software Quality Requirements and Evaluation (SQuaRE) — product quality model (iso25000.com). Verified 2026-06-05."@en ;
    rdfs:subClassOf o4se:QualityAttribute ;
    skos:definition "The degree to which a software product can be used by specified users to achieve specified goals with effectiveness, efficiency, and satisfaction in a specified context of use."@en .

o4se:User a owl:Class ;
    rdfs:label "User"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017, Systems and software engineering — Vocabulary (SEVOCAB). Verified 2026-06-05."@en ;
    rdfs:subClassOf o4se:Stakeholder ;
    skos:definition "A stakeholder who interacts with or operates a software system."@en .

o4se:VersionControlTool a owl:Class ;
    rdfs:label "Version Control Tool"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017, Systems and software engineering — Vocabulary (SEVOCAB). Verified 2026-06-05."@en ;
    rdfs:subClassOf o4se:Tool ;
    skos:definition "A tool that records and manages changes to source code and other artifacts over time."@en .

o4se:WaterfallModel a o4se:TraditionalMethodology ;
    rdfs:label "Waterfall Model"@en ;
    o4se:hasDescription "Linear sequential approach to software development"@en .

o4se:basedOn a owl:ObjectProperty ;
    rdfs:label "based on"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017 / 12207:2017 — software life-cycle vocabulary & processes."@en ;
    rdfs:domain o4se:DesignDocument ;
    rdfs:range o4se:Requirement ;
    skos:definition "Relates a design document to a requirement on which it is based."@en .

o4se:follows a owl:ObjectProperty ;
    rdfs:label "follows"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017 / 12207:2017 — software life-cycle vocabulary & processes."@en ;
    rdfs:domain o4se:SoftwareSystem ;
    rdfs:range o4se:Methodology ;
    skos:definition "Relates a software system to the methodology it follows."@en .

o4se:hasComplexity a owl:DatatypeProperty ;
    rdfs:label "has complexity"@en ;
    dcterms:source "Structural property defined by its O4SE domain and range (O4SE modelling convention)."@en ;
    rdfs:domain o4se:SoftwareSystem ;
    rdfs:range xsd:string ;
    skos:definition "The complexity of a software system, recorded as a literal value."@en .

o4se:hasCost a owl:DatatypeProperty ;
    rdfs:label "has cost"@en ;
    dcterms:source "Structural property defined by its O4SE domain and range (O4SE modelling convention)."@en ;
    rdfs:domain o4se:Process ;
    rdfs:range xsd:decimal ;
    skos:definition "The monetary cost of a process."@en .

o4se:hasDescription a owl:DatatypeProperty ;
    rdfs:label "has description"@en ;
    dcterms:source "Structural property defined by its O4SE domain and range (O4SE modelling convention)."@en ;
    rdfs:range rdfs:Literal ;
    skos:definition "A natural-language description of the subject; language-tagged literals are permitted (range rdfs:Literal)."@en ;
    skos:editorialNote "Range widened xsd:string -> rdfs:Literal (2026-06-05, owner-authorized) to admit language-tagged (@en) values without OWL2-DL clash; resolves SD-14. AllDisjointClasses unchanged."@en .

o4se:hasDuration a owl:DatatypeProperty ;
    rdfs:label "has duration"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017 / 12207:2017 — software life-cycle vocabulary & processes."@en ;
    rdfs:comment "Range relaxed xsd:duration->xsd:string for OWL 2 DL (DRIFT-19); value is an ISO-8601 duration lexical string (e.g. 'P2D')."@en ;
    rdfs:domain o4se:Activity ;
    rdfs:range xsd:string ;
    skos:definition "The duration of an activity (range relaxed to xsd:string for OWL 2 DL per DRIFT-19)."@en .

o4se:hasEndDate a owl:DatatypeProperty ;
    rdfs:label "has end date"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017 / 12207:2017 — software life-cycle vocabulary & processes."@en ;
    rdfs:domain o4se:LifecyclePhase ;
    rdfs:range xsd:string ;
    skos:definition "The end date of a lifecycle phase, recorded as a literal."@en .

o4se:hasMetricValue a owl:DatatypeProperty ;
    rdfs:label "has metric value"@en ;
    dcterms:source "ISO/IEC 25010 product-quality model."@en ;
    rdfs:domain o4se:QualityAttribute ;
    rdfs:range xsd:decimal ;
    skos:definition "The measured value of a quality attribute's metric."@en .

o4se:hasName a owl:DatatypeProperty ;
    rdfs:label "has name"@en ;
    dcterms:source "Structural property defined by its O4SE domain and range (O4SE modelling convention)."@en ;
    rdfs:domain o4se:SoftwareSystem ;
    rdfs:range xsd:string ;
    skos:definition "The name of a software system."@en .

o4se:hasPhase a owl:ObjectProperty ;
    rdfs:label "has phase"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017 / 12207:2017 — software life-cycle vocabulary & processes."@en ;
    rdfs:domain o4se:SoftwareProcess ;
    rdfs:range o4se:LifecyclePhase ;
    skos:definition "Relates a software process to a lifecycle phase it comprises."@en .

o4se:hasPriority a owl:DatatypeProperty ;
    rdfs:label "has priority"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017 / 12207:2017 — software life-cycle vocabulary & processes."@en ;
    rdfs:domain o4se:Requirement ;
    rdfs:range xsd:integer ;
    skos:definition "The priority of a requirement, as an integer."@en .

o4se:hasQualityAttribute a owl:ObjectProperty ;
    rdfs:label "has quality attribute"@en ;
    dcterms:source "ISO/IEC 25010 product-quality model."@en ;
    rdfs:domain o4se:SoftwareSystem ;
    rdfs:range o4se:QualityAttribute ;
    skos:definition "Relates a software system to a quality attribute it exhibits."@en .

o4se:hasStartDate a owl:DatatypeProperty ;
    rdfs:label "has start date"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017 / 12207:2017 — software life-cycle vocabulary & processes."@en ;
    rdfs:domain o4se:LifecyclePhase ;
    rdfs:range xsd:string ;
    skos:definition "The start date of a lifecycle phase, recorded as a literal."@en .

o4se:hasVersion a owl:DatatypeProperty ;
    rdfs:label "has version"@en ;
    dcterms:source "Structural property defined by its O4SE domain and range (O4SE modelling convention)."@en ;
    rdfs:domain o4se:SoftwareSystem ;
    rdfs:range xsd:string ;
    skos:definition "The version identifier of a software system."@en .

o4se:implements a owl:ObjectProperty ;
    rdfs:label "implements"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017 / 12207:2017 — software life-cycle vocabulary & processes."@en ;
    rdfs:domain o4se:SourceCode ;
    rdfs:range o4se:Requirement ;
    skos:definition "Relates source code to a requirement it implements."@en .

o4se:includes a owl:ObjectProperty ;
    rdfs:label "includes"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017 / 12207:2017 — software life-cycle vocabulary & processes."@en ;
    rdfs:domain o4se:Process ;
    rdfs:range o4se:Activity ;
    skos:definition "Relates a process to an activity it includes."@en .

o4se:participatesIn a owl:ObjectProperty ;
    rdfs:label "participates in"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017 / 12207:2017 — software life-cycle vocabulary & processes."@en ;
    rdfs:domain o4se:Stakeholder ;
    rdfs:range o4se:Process ;
    skos:definition "Relates a stakeholder to a process in which they participate."@en .

o4se:performedBy a owl:ObjectProperty ;
    rdfs:label "performed by"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017 / 12207:2017 — software life-cycle vocabulary & processes."@en ;
    rdfs:domain o4se:Activity ;
    rdfs:range o4se:Stakeholder ;
    skos:definition "Relates an activity to the stakeholder who performs it."@en .

o4se:precedes a owl:ObjectProperty ;
    rdfs:label "precedes"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017 / 12207:2017 — software life-cycle vocabulary & processes."@en ;
    rdfs:domain o4se:LifecyclePhase ;
    rdfs:range o4se:LifecyclePhase ;
    skos:definition "Relates a lifecycle phase to a phase that follows it in sequence."@en .

o4se:produces a owl:ObjectProperty ;
    rdfs:label "produces"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017 / 12207:2017 — software life-cycle vocabulary & processes."@en ;
    rdfs:domain o4se:Activity ;
    rdfs:range o4se:Artifact ;
    skos:definition "Relates an activity to an artifact it produces."@en .

o4se:responsibleFor a owl:ObjectProperty ;
    rdfs:label "responsible for"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017 / 12207:2017 — software life-cycle vocabulary & processes."@en ;
    rdfs:domain o4se:Stakeholder ;
    rdfs:range o4se:Artifact ;
    skos:definition "Relates a stakeholder to an artifact for which they are responsible."@en .

o4se:supports a owl:ObjectProperty ;
    rdfs:label "supports"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017 / 12207:2017 — software life-cycle vocabulary & processes."@en ;
    rdfs:domain o4se:Tool ;
    rdfs:range o4se:Activity ;
    skos:definition "Relates a tool to an activity it supports."@en .

o4se:uses a owl:ObjectProperty ;
    rdfs:label "uses"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017 / 12207:2017 — software life-cycle vocabulary & processes."@en ;
    rdfs:domain o4se:Activity ;
    rdfs:range o4se:Tool ;
    skos:definition "Relates an activity to a tool it uses."@en .

o4se:validates a owl:ObjectProperty ;
    rdfs:label "validates"@en ;
    dcterms:source "ISO/IEC/IEEE 29119 software testing."@en ;
    rdfs:domain o4se:TestCase ;
    rdfs:range o4se:Requirement ;
    skos:definition "Relates a test case to a requirement it validates."@en .

<http://www.semanticweb.org/ontologies/2025/O4SE/Architectures> a owl:Ontology ;
    dcterms:created "2026-06-05"^^xsd:date ;
    dcterms:creator <http://www.zt4swe.io/agent/YusufAltunel> ;
    dcterms:description "Comprehensive software and hardware architecture patterns for software engineering"@en ;
    dcterms:identifier "O4SE_Architectures_v1_0_1" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-06-05"^^xsd:date ;
    dcterms:publisher <http://www.zt4swe.io/agent/YusufAltunel> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed under CC BY 4.0."@en ;
    dcterms:rightsHolder <http://www.zt4swe.io/agent/YusufAltunel> ;
    dcterms:title "O4SE Software Architectures Module"@en ;
    rdfs:comment "v1.0.1 owner-controlled remediation: added owl:versionIRI + BP-D24 metadata; repaired DRIFT-19 datatype ranges. NOTE: the original 1.0.0 Protege draft carried no recorded creation date (the SD-7 provenance gap); dcterms:created reflects this first provenanced release. SWEBOK/CMMI and general SE literature are the concept sources; book is dcterms:source, not owner."@en,
        "v1.0.2: Tier-1 definition pass — 100 class skos:definition added, grounded in existing rdfs:comment (internal authority). Tier-2 (external seminal sources) pending."@en ;
    owl:imports <http://www.semanticweb.org/ontologies/2025/O4SE> ;
    owl:priorVersion <http://www.semanticweb.org/ontologies/2025/O4SE/Architectures/1.0.8> ;
    owl:versionIRI <http://www.semanticweb.org/ontologies/2025/O4SE/Architectures/1.0.9> ;
    owl:versionInfo "1.0.9" ;
    prov:wasAttributedTo <http://www.zt4swe.io/agent/YusufAltunel> ;
    prov:wasGeneratedBy <http://www.zt4swe.io/activity/o4se-remediation-v1_0_1> .

arch:APILayer a owl:Class ;
    rdfs:label "API Layer"@en ;
    rdfs:subClassOf arch:IntegrationLayer ;
    skos:definition "Application Programming Interface"@en .

arch:ARMArchitecture a owl:Class ;
    rdfs:label "ARM Architecture"@en ;
    dcterms:source "Hennessy, J.L. & Patterson, D.A., Computer Architecture: A Quantitative Approach (seminal reference for instruction-set architecture)."@en ;
    rdfs:subClassOf arch:ProcessorArchitecture ;
    skos:definition "A RISC-based processor instruction set architecture developed by Arm, widely used in mobile and embedded devices for its power efficiency."@en .

arch:AWSCloud a arch:PublicCloud ;
    rdfs:label "Amazon Web Services"@en .

arch:AzureCloud a arch:PublicCloud ;
    rdfs:label "Microsoft Azure"@en .

arch:Bitcoin a arch:BlockchainArchitecture ;
    rdfs:label "Bitcoin Blockchain"@en ;
    arch:usesConsensus arch:ProofOfWork .

arch:CISCArchitecture a owl:Class ;
    rdfs:label "CISC Architecture"@en ;
    dcterms:source "Hennessy, J.L. & Patterson, D.A., Computer Architecture: A Quantitative Approach (seminal reference for instruction-set architecture)."@en ;
    rdfs:subClassOf arch:ProcessorArchitecture ;
    skos:definition "A processor architecture based on a Complex Instruction Set Computer design, providing many, often variable-length, multi-step instructions."@en .

arch:CachingLayer a owl:Class ;
    rdfs:label "Caching Layer"@en ;
    rdfs:subClassOf arch:ApplicationLayer ;
    skos:definition "Performance optimization through caching"@en .

arch:CloudNativeArchitecture a owl:Class ;
    rdfs:label "Cloud-Native Architecture"@en ;
    rdfs:subClassOf arch:CloudArchitecture ;
    skos:definition "Built specifically for cloud"@en .

arch:DApp a owl:Class ;
    rdfs:label "Decentralized Application"@en ;
    rdfs:subClassOf o4se:Application ;
    skos:definition "Application running on blockchain"@en .

arch:DataAccessLayer a owl:Class ;
    rdfs:label "Data Access Layer"@en ;
    rdfs:subClassOf arch:ApplicationLayer ;
    skos:definition "Database interaction logic"@en .

arch:DatabaseLayer a owl:Class ;
    rdfs:label "Database Layer"@en ;
    rdfs:subClassOf arch:ApplicationLayer ;
    skos:definition "Data persistence and storage"@en .

arch:DecentralizedArchitecture a owl:Class ;
    rdfs:label "Decentralized Architecture"@en ;
    rdfs:subClassOf arch:DistributedArchitecture ;
    skos:definition "No central authority or control"@en .

arch:EdgeComputingArchitecture a owl:Class ;
    rdfs:label "Edge Computing Architecture"@en ;
    rdfs:subClassOf arch:DistributedArchitecture ;
    skos:definition "Processing at network edge"@en .

arch:EmbeddedSystemArchitecture a owl:Class ;
    rdfs:label "Embedded System Architecture"@en ;
    rdfs:subClassOf arch:HardwareArchitecture ;
    skos:definition "Dedicated function within larger system"@en .

arch:Ethereum a arch:BlockchainArchitecture ;
    rdfs:label "Ethereum Blockchain"@en ;
    arch:usesConsensus arch:ProofOfStake .

arch:EventDrivenArchitecture a owl:Class ;
    rdfs:label "Event-Driven Architecture"@en ;
    rdfs:subClassOf arch:ArchitecturePattern ;
    skos:definition "Components communicate through events"@en .

arch:FederatedArchitecture a owl:Class ;
    rdfs:label "Federated Architecture"@en ;
    rdfs:subClassOf arch:DistributedArchitecture ;
    skos:definition "Independent systems cooperating"@en .

arch:FogComputingArchitecture a owl:Class ;
    rdfs:label "Fog Computing Architecture"@en ;
    dcterms:source "Bonomi et al. (2012), 'Fog Computing and Its Role in the Internet of Things' (Cisco)."@en ;
    rdfs:subClassOf arch:DistributedArchitecture ;
    skos:definition "A distributed computing architecture that extends cloud services toward the network edge, placing computation, storage, and networking between end devices and the cloud."@en .

arch:FrontendLayer a owl:Class ;
    rdfs:label "Frontend Layer"@en ;
    rdfs:subClassOf arch:PresentationLayer ;
    skos:definition "Client-side user interface"@en .

arch:GoogleCloud a arch:PublicCloud ;
    rdfs:label "Google Cloud Platform"@en .

arch:GraphQLAPI a owl:Class ;
    rdfs:label "GraphQL API"@en ;
    rdfs:subClassOf arch:APIArchitecture ;
    skos:definition "Query language for APIs"@en .

arch:GridComputingArchitecture a owl:Class ;
    rdfs:label "Grid Computing Architecture"@en ;
    dcterms:source "Foster, I. & Kesselman, C., The Grid: Blueprint for a New Computing Infrastructure."@en ;
    rdfs:subClassOf arch:DistributedArchitecture ;
    skos:definition "A distributed computing architecture that aggregates geographically dispersed, heterogeneous resources into a coordinated virtual supercomputer for shared workloads."@en .

arch:HexagonalArchitecture a owl:Class ;
    rdfs:label "Hexagonal Architecture"@en ;
    rdfs:subClassOf arch:ArchitecturePattern ;
    skos:definition "Ports and adapters pattern"@en .

arch:HybridCloud a owl:Class ;
    rdfs:label "Hybrid Cloud"@en ;
    dcterms:source "NIST SP 800-145, The NIST Definition of Cloud Computing (2011). Verified 2026-06-05."@en ;
    rdfs:subClassOf arch:CloudArchitecture ;
    skos:definition "A cloud deployment model composed of two or more distinct cloud infrastructures (private, community, or public) that remain unique entities but are bound together to enable data and application portability."@en .

arch:IoTArchitecture a owl:Class ;
    rdfs:label "IoT Architecture"@en ;
    rdfs:subClassOf arch:HardwareArchitecture ;
    skos:definition "Internet of Things devices"@en .

arch:LayeredArchitecture a owl:Class ;
    rdfs:label "Layered Architecture"@en ;
    rdfs:subClassOf arch:ArchitecturePattern ;
    skos:definition "Organized into horizontal layers"@en .

arch:MiddlewareLayer a owl:Class ;
    rdfs:label "Middleware Layer"@en ;
    rdfs:subClassOf arch:IntegrationLayer ;
    skos:definition "Software between OS and applications"@en .

arch:ModelViewControllerArchitecture a owl:Class ;
    rdfs:label "Model-View-Controller (MVC)"@en ;
    rdfs:subClassOf arch:ArchitecturePattern ;
    skos:definition "Separates data, presentation, and control"@en .

arch:ModelViewPresenterArchitecture a owl:Class ;
    rdfs:label "Model-View-Presenter (MVP)"@en ;
    dcterms:source "Potel, M. (1996), 'MVP: Model-View-Presenter' (Taligent)."@en ;
    rdfs:subClassOf arch:ArchitecturePattern ;
    skos:definition "A user-interface architectural pattern that separates the model, the view, and a presenter that mediates between them and contains presentation logic."@en .

arch:ModelViewViewModelArchitecture a owl:Class ;
    rdfs:label "Model-View-ViewModel (MVVM)"@en ;
    dcterms:source "Gossman, J. (2005), Model-View-ViewModel pattern (Microsoft WPF)."@en ;
    rdfs:subClassOf arch:ArchitecturePattern ;
    skos:definition "A user-interface architectural pattern that separates the model, the view, and a view-model exposing bindable state and commands, enabling declarative data binding."@en .

arch:MonolithicArchitecture a owl:Class ;
    rdfs:label "Monolithic Architecture"@en ;
    rdfs:subClassOf arch:ArchitecturePattern ;
    skos:definition "Single deployable unit containing all functionality"@en .

arch:MultiCloud a owl:Class ;
    rdfs:label "Multi-Cloud"@en ;
    rdfs:subClassOf arch:CloudArchitecture ;
    skos:definition "Using multiple cloud providers"@en .

arch:PeerToPeerArchitecture a owl:Class ;
    rdfs:label "Peer-to-Peer Architecture"@en ;
    rdfs:subClassOf arch:DistributedArchitecture ;
    skos:definition "Decentralized resource sharing"@en .

arch:PipeAndFilterArchitecture a owl:Class ;
    rdfs:label "Pipe and Filter Architecture"@en ;
    rdfs:subClassOf arch:ArchitecturePattern ;
    skos:definition "Data flows through processing components"@en .

arch:PrivateCloud a owl:Class ;
    rdfs:label "Private Cloud"@en ;
    dcterms:source "NIST SP 800-145, The NIST Definition of Cloud Computing (2011). Verified 2026-06-05."@en ;
    rdfs:subClassOf arch:CloudArchitecture ;
    skos:definition "A cloud deployment model in which the cloud infrastructure is provisioned for exclusive use by a single organization, whether on or off premises."@en .

arch:RESTArchitecturalStyle a arch:ArchitectureStyle ;
    rdfs:label "REST Architectural Style"@en ;
    o4se:hasDescription "Representational State Transfer constraints"@en .

arch:RESTfulAPI a owl:Class ;
    rdfs:label "RESTful API"@en ;
    rdfs:subClassOf arch:APIArchitecture ;
    skos:definition "Representational State Transfer"@en .

arch:RISCArchitecture a owl:Class ;
    rdfs:label "RISC Architecture"@en ;
    dcterms:source "Hennessy, J.L. & Patterson, D.A., Computer Architecture: A Quantitative Approach (seminal reference for instruction-set architecture)."@en ;
    rdfs:subClassOf arch:ProcessorArchitecture ;
    skos:definition "A processor architecture based on a Reduced Instruction Set Computer design, using a small set of simple, fixed-length instructions executed in few cycles."@en .

arch:SOAPAPI a owl:Class ;
    rdfs:label "SOAP API"@en ;
    rdfs:subClassOf arch:APIArchitecture ;
    skos:definition "Simple Object Access Protocol"@en .

arch:ServerlessArchitecture a owl:Class ;
    rdfs:label "Serverless Architecture"@en ;
    rdfs:subClassOf arch:ArchitecturePattern ;
    skos:definition "Functions as a Service (FaaS)"@en .

arch:ServiceOrientedArchitecture a owl:Class ;
    rdfs:label "Service-Oriented Architecture (SOA)"@en ;
    rdfs:subClassOf arch:ArchitecturePattern ;
    skos:definition "Services communicate through interfaces"@en .

arch:SmartContract a owl:Class ;
    rdfs:label "Smart Contract"@en ;
    dcterms:source "Grounded in the O4SE source ontology's existing rdfs:comment for this class (internal authority), normalised to genus-differentia form during O4SE v1.0.2 trust remediation. SWEBOK knowledge-area definitions additionally reflect the IEEE SWEBOK Guide."@en ;
    rdfs:comment "Self-executing contract on blockchain"@en ;
    rdfs:subClassOf o4se:Software ;
    skos:definition "A software artifact that is a self-executing contract whose terms are encoded as program logic and executed on a blockchain."@en .

arch:SoftwareArchitecture a owl:Class ;
    rdfs:label "Software Architecture"@en ;
    rdfs:subClassOf arch:Architecture ;
    skos:definition "Fundamental organization of a software system"@en .

arch:ThreeTierArchitecture a owl:Class ;
    rdfs:label "Three-Tier Architecture"@en ;
    rdfs:subClassOf arch:ClientServerArchitecture ;
    skos:definition "Presentation, business logic, and data tiers"@en .

arch:WebSocketAPI a owl:Class ;
    rdfs:label "WebSocket API"@en ;
    rdfs:subClassOf arch:APIArchitecture ;
    skos:definition "Full-duplex communication"@en .

arch:communicatesWith a owl:ObjectProperty ;
    rdfs:label "communicates with"@en ;
    dcterms:source "Software/system architecture references (Hennessy & Patterson; NIST SP 800-145; Fowler)."@en ;
    rdfs:domain arch:ApplicationLayer ;
    rdfs:range arch:ApplicationLayer ;
    skos:definition "Relates an application layer to another layer with which it communicates."@en .

arch:deployedOn a owl:ObjectProperty ;
    rdfs:label "deployed on"@en ;
    dcterms:source "Software/system architecture references (Hennessy & Patterson; NIST SP 800-145; Fowler)."@en ;
    rdfs:domain o4se:Software ;
    rdfs:range arch:CloudArchitecture ;
    skos:definition "Relates software to the cloud architecture on which it is deployed."@en .

arch:exposesAPI a owl:ObjectProperty ;
    rdfs:label "exposes API"@en ;
    dcterms:source "Software/system architecture references (Hennessy & Patterson; NIST SP 800-145; Fowler)."@en ;
    rdfs:domain arch:BackendLayer ;
    rdfs:range arch:APIArchitecture ;
    skos:definition "Relates a backend layer to the API architecture it exposes."@en .

arch:gRPCAPI a owl:Class ;
    rdfs:label "gRPC API"@en ;
    rdfs:subClassOf arch:APIArchitecture ;
    skos:definition "Remote Procedure Call framework"@en .

arch:hasArchitecture a owl:ObjectProperty ;
    rdfs:label "has architecture"@en ;
    dcterms:source "Software/system architecture references (Hennessy & Patterson; NIST SP 800-145; Fowler)."@en ;
    rdfs:domain o4se:SoftwareSystem ;
    rdfs:range arch:Architecture ;
    skos:definition "Relates a software system to its architecture."@en .

arch:hasLayer a owl:ObjectProperty ;
    rdfs:label "has layer"@en ;
    dcterms:source "Software/system architecture references (Hennessy & Patterson; NIST SP 800-145; Fowler)."@en ;
    rdfs:domain arch:Architecture ;
    rdfs:range arch:ApplicationLayer ;
    skos:definition "Relates an architecture to a layer it comprises."@en .

arch:implementsPattern a owl:ObjectProperty ;
    rdfs:label "implements pattern"@en ;
    dcterms:source "Software/system architecture references (Hennessy & Patterson; NIST SP 800-145; Fowler)."@en ;
    rdfs:domain o4se:SoftwareSystem ;
    rdfs:range arch:ArchitecturePattern ;
    skos:definition "Relates a software system to an architecture pattern it implements."@en .

arch:latencyRequirement a owl:DatatypeProperty ;
    rdfs:label "latency requirement"@en ;
    dcterms:source "Software/system architecture references (Hennessy & Patterson; NIST SP 800-145; Fowler)."@en ;
    rdfs:comment "Range relaxed xsd:duration->xsd:string for OWL 2 DL (DRIFT-19); value is an ISO-8601 duration lexical string (e.g. 'P2D')."@en ;
    rdfs:domain arch:Architecture ;
    rdfs:range xsd:string ;
    skos:definition "The latency requirement of an architecture (range relaxed to xsd:string per DRIFT-19)."@en .

arch:numberOfServices a owl:DatatypeProperty ;
    rdfs:label "number of services"@en ;
    dcterms:source "Software/system architecture references (Hennessy & Patterson; NIST SP 800-145; Fowler)."@en ;
    rdfs:domain arch:MicroservicesArchitecture ;
    rdfs:range xsd:integer ;
    skos:definition "The number of services in a microservices architecture."@en .

arch:numberOfTiers a owl:DatatypeProperty ;
    rdfs:label "number of tiers"@en ;
    dcterms:source "Software/system architecture references (Hennessy & Patterson; NIST SP 800-145; Fowler)."@en ;
    rdfs:domain arch:NTierArchitecture ;
    rdfs:range xsd:integer ;
    skos:definition "The number of tiers in an n-tier architecture."@en .

arch:runsOn a owl:ObjectProperty ;
    rdfs:label "runs on"@en ;
    dcterms:source "Software/system architecture references (Hennessy & Patterson; NIST SP 800-145; Fowler)."@en ;
    rdfs:domain o4se:Software ;
    rdfs:range arch:HardwareArchitecture ;
    skos:definition "Relates software to the hardware architecture on which it runs."@en .

arch:scalabilityLevel a owl:DatatypeProperty ;
    rdfs:label "scalability level"@en ;
    dcterms:source "Software/system architecture references (Hennessy & Patterson; NIST SP 800-145; Fowler)."@en ;
    rdfs:comment "horizontal, vertical, or both"@en ;
    rdfs:domain arch:Architecture ;
    rdfs:range xsd:string ;
    skos:definition "The scalability mode of an architecture (horizontal, vertical, or both)."@en .

arch:usesConsensus a owl:ObjectProperty ;
    rdfs:label "uses consensus"@en ;
    dcterms:source "Software/system architecture references (Hennessy & Patterson; NIST SP 800-145; Fowler)."@en ;
    rdfs:domain arch:BlockchainArchitecture ;
    rdfs:range arch:ConsensusAlgorithm ;
    skos:definition "Relates a blockchain architecture to the consensus algorithm it uses."@en .

arch:x86Architecture a owl:Class ;
    rdfs:label "x86 Architecture"@en ;
    dcterms:source "Hennessy, J.L. & Patterson, D.A., Computer Architecture: A Quantitative Approach (seminal reference for instruction-set architecture)."@en ;
    rdfs:subClassOf arch:ProcessorArchitecture ;
    skos:definition "A CISC family of processor instruction set architectures originating with the Intel 8086, dominant in personal computers and servers."@en .

<http://www.semanticweb.org/ontologies/2025/O4SE/CMMI> a owl:Ontology ;
    dcterms:created "2026-06-05"^^xsd:date ;
    dcterms:creator <http://www.zt4swe.io/agent/YusufAltunel> ;
    dcterms:description "Integration of SEI CMMI process areas and maturity model into O4SE"@en ;
    dcterms:identifier "O4SE_CMMI_v1_0_1" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-06-05"^^xsd:date ;
    dcterms:publisher <http://www.zt4swe.io/agent/YusufAltunel> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed under CC BY 4.0."@en ;
    dcterms:rightsHolder <http://www.zt4swe.io/agent/YusufAltunel> ;
    dcterms:title "O4SE CMMI Integration Module"@en ;
    rdfs:comment "v1.0.1 owner-controlled remediation: added owl:versionIRI + BP-D24 metadata; repaired DRIFT-19 datatype ranges. NOTE: the original 1.0.0 Protege draft carried no recorded creation date (the SD-7 provenance gap); dcterms:created reflects this first provenanced release. SWEBOK/CMMI and general SE literature are the concept sources; book is dcterms:source, not owner."@en,
        "v1.0.2: Tier-1 definition pass — 100 class skos:definition added, grounded in existing rdfs:comment (internal authority). Tier-2 (external seminal sources) pending."@en ;
    owl:imports <http://www.semanticweb.org/ontologies/2025/O4SE> ;
    owl:priorVersion <http://www.semanticweb.org/ontologies/2025/O4SE/CMMI/1.0.8> ;
    owl:versionIRI <http://www.semanticweb.org/ontologies/2025/O4SE/CMMI/1.0.9> ;
    owl:versionInfo "1.0.9" ;
    prov:wasAttributedTo <http://www.zt4swe.io/agent/YusufAltunel> ;
    prov:wasGeneratedBy <http://www.zt4swe.io/activity/o4se-remediation-v1_0_1> .

cmmi:CMMI_ACQ a cmmi:ProcessMaturityFramework ;
    rdfs:label "CMMI for Acquisition"@en ;
    o4se:hasDescription "CMMI model for acquisition processes"@en .

cmmi:CMMI_DEV a cmmi:ProcessMaturityFramework ;
    rdfs:label "CMMI for Development"@en ;
    o4se:hasDescription "CMMI model for product and service development"@en .

cmmi:CMMI_SVC a cmmi:ProcessMaturityFramework ;
    rdfs:label "CMMI for Services"@en ;
    o4se:hasDescription "CMMI model for service establishment and delivery"@en .

cmmi:CausalAnalysisAndResolution_CAR a owl:Class ;
