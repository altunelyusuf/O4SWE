prog:CodeDuplication a owl:Class ;
    rdfs:label "Code Duplication"@en ;
    dcterms:source "Standard software-size metrics (e.g., ISO/IEC 25023; SLOC counting conventions)."@en ;
    rdfs:subClassOf prog:CodeMetric ;
    skos:definition "A metric and code smell denoting repeated or near-identical code fragments across a codebase."@en .

prog:CohesionMetric a owl:Class ;
    rdfs:label "Cohesion Metric"@en ;
    dcterms:source "Chidamber, S.R. & Kemerer, C.F. (1994), 'A Metrics Suite for Object-Oriented Design'; cf. Stevens, Myers & Constantine (coupling/cohesion)."@en ;
    rdfs:subClassOf prog:CodeMetric ;
    skos:definition "A metric quantifying the degree to which the elements of a module belong together; higher cohesion is generally preferred."@en .

prog:CouplingMetric a owl:Class ;
    rdfs:label "Coupling Metric"@en ;
    dcterms:source "Chidamber, S.R. & Kemerer, C.F. (1994), 'A Metrics Suite for Object-Oriented Design'; cf. Stevens, Myers & Constantine (coupling/cohesion)."@en ;
    rdfs:subClassOf prog:CodeMetric ;
    skos:definition "A metric quantifying the degree of interdependence between software modules; lower coupling is generally preferred."@en .

prog:Debugger a owl:Class ;
