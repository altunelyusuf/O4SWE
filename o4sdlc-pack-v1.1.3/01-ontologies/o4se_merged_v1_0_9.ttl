[] a owl:AllDisjointClasses ;
    owl:members ( o4se:Stakeholder o4se:Process o4se:Artifact o4se:Tool o4se:QualityAttribute ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( method:Waterfall method:Scrum method:Kanban method:XP ) .

