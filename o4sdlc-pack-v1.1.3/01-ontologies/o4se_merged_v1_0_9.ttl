    dcterms:source "Sebesta, Concepts of Programming Languages."@en ;
    rdfs:domain prog:ProgrammingLanguage ;
    rdfs:range prog:CompilationModel ;
    skos:definition "Relates a programming language to its compilation model."@en .

prog:writtenIn a owl:ObjectProperty ;
    rdfs:label "written in"@en ;
    dcterms:source "Sebesta, Concepts of Programming Languages."@en ;
