prog:languageVersion a owl:DatatypeProperty ;
    rdfs:label "language version"@en ;
    dcterms:source "Sebesta, Concepts of Programming Languages."@en ;
    rdfs:domain prog:ProgrammingLanguage ;
    rdfs:range xsd:string ;
    skos:definition "The version of a programming language."@en .

prog:locValue a owl:DatatypeProperty ;
