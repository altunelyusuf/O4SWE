    rdfs:domain prog:ProgrammingLanguage ;
    rdfs:range prog:ProgrammingParadigm ;
    skos:definition "Relates a programming language to a paradigm it follows."@en .

prog:hasMetric a owl:ObjectProperty ;
    rdfs:label "has metric"@en ;
    dcterms:source "Software metrics: McCabe (cyclomatic complexity); Chidamber & Kemerer; SLOC; ISO/IEC 25023."@en ;
    rdfs:domain prog:SourceCode ;
    rdfs:range prog:CodeMetric ;
    skos:definition "Relates source code to a code metric measured on it."@en .

prog:hasTypeSystem a owl:ObjectProperty ;
    rdfs:label "has type system"@en ;
    dcterms:source "Sebesta, Concepts of Programming Languages."@en ;
    rdfs:domain prog:ProgrammingLanguage ;
    rdfs:range prog:TypeSystem ;
