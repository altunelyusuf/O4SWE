    dcterms:source "Sebesta, Concepts of Programming Languages."@en ;
    rdfs:domain prog:ProgrammingLanguage ;
    rdfs:range prog:LanguageGeneration ;
    skos:definition "Relates a programming language to its language generation."@en .

prog:compiledBy a owl:ObjectProperty ;
