swebok:AcceptanceTesting a owl:Class ;
    rdfs:label "Acceptance Testing"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017, Systems and software engineering — Vocabulary (SEVOCAB); cross-referenced with ISO/IEC/IEEE 29119 Software Testing and the SWEBOK Guide Software Testing KA. Verified authority 2026-06-05; definitions paraphrased from the standard's framework."@en ;
    rdfs:subClassOf swebok:TestLevel ;
    skos:definition "Formal testing conducted to determine whether a system satisfies its acceptance criteria, enabling the customer to decide whether to accept the system."@en .

swebok:AdaptiveMaintenance a owl:Class ;
    rdfs:label "Adaptive Maintenance"@en ;
    rdfs:subClassOf o4se:Maintenance ;
    skos:definition "Adapting software to environmental changes"@en .

swebok:BlackBoxTesting a owl:Class ;
    rdfs:label "Black Box Testing"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017, Systems and software engineering — Vocabulary (SEVOCAB); cross-referenced with ISO/IEC/IEEE 29119 Software Testing and the SWEBOK Guide Software Testing KA. Verified authority 2026-06-05; definitions paraphrased from the standard's framework."@en ;
    rdfs:subClassOf swebok:TestTechnique ;
    skos:definition "Testing that disregards a component's internal structure and derives test cases solely from its specified inputs, outputs, and behaviour; also termed functional or specification-based testing."@en .

swebok:ChangeControl a owl:Class ;
    rdfs:label "Change Control"@en ;
    rdfs:subClassOf o4se:SupportProcess ;
    skos:definition "Process for managing changes to software"@en .

swebok:CodeReview a owl:Class ;
    rdfs:label "Code Review"@en ;
    rdfs:subClassOf o4se:Activity ;
    skos:definition "Systematic examination of source code"@en .

swebok:CodingStandard a owl:Class ;
    rdfs:label "Coding Standard"@en ;
    rdfs:subClassOf o4se:Artifact ;
    skos:definition "Set of guidelines for writing code"@en .

swebok:ConfigurationAudit a owl:Class ;
    rdfs:label "Configuration Audit"@en ;
    rdfs:subClassOf o4se:Activity ;
    skos:definition "Verifying configuration status and compliance"@en .

swebok:ConfigurationIdentification a owl:Class ;
    rdfs:label "Configuration Identification"@en ;
    rdfs:subClassOf o4se:Activity ;
    skos:definition "Identifying and documenting configuration items"@en .

swebok:CorrectiveMaintenance a owl:Class ;
    rdfs:label "Corrective Maintenance"@en ;
    rdfs:subClassOf o4se:Maintenance ;
    skos:definition "Fixing defects in software"@en .

swebok:DRY a swebok:DesignPrinciple ;
    rdfs:label "DRY Principle"@en ;
    o4se:hasDescription "Don't Repeat Yourself - avoid duplication of logic"@en .

swebok:DetailedDesign a owl:Class ;
    rdfs:label "Detailed Design"@en ;
    rdfs:subClassOf o4se:Design ;
    skos:definition "Low-level design of software components and modules"@en .

swebok:FactoryPattern a swebok:DesignPattern ;
    rdfs:label "Factory Pattern"@en ;
    o4se:hasDescription "Creates objects without specifying exact classes"@en .

swebok:FormalMethod a owl:Class ;
    rdfs:label "Formal Method"@en ;
    rdfs:subClassOf swebok:DevelopmentMethod ;
    skos:definition "Mathematically rigorous techniques for software development"@en .

swebok:IntegrationTesting a owl:Class ;
    rdfs:label "Integration Testing"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017, Systems and software engineering — Vocabulary (SEVOCAB); cross-referenced with ISO/IEC/IEEE 29119 Software Testing and the SWEBOK Guide Software Testing KA. Verified authority 2026-06-05; definitions paraphrased from the standard's framework."@en ;
    rdfs:subClassOf swebok:TestLevel ;
    skos:definition "Testing in which software components are combined and tested to evaluate the interactions among them."@en .

swebok:KISS a swebok:DesignPrinciple ;
    rdfs:label "KISS Principle"@en ;
    o4se:hasDescription "Keep It Simple, Stupid - favor simplicity in design"@en .

swebok:LegalCompliance a owl:Class ;
