org1:AcademicDevelopment a owl:Class ;
    rdfs:label "Academic Development"@en ;
    rdfs:subClassOf org1:DevelopmentContext ;
    skos:definition "Educational or research development"@en .

org1:AcademicInstitution a owl:Class ;
    rdfs:label "Academic Institution"@en ;
    rdfs:subClassOf org1:Organization ;
    skos:definition "University or research institution"@en .

org1:Accountable a org1:RACIRole ;
    rdfs:label "Accountable"@en ;
    skos:definition "Ultimately answerable"@en .

org1:AdvancedLevel a owl:Class ;
    rdfs:label "Advanced Level"@en ;
    dcterms:source "Five-stage skill-proficiency scale (cf. Dreyfus & Dreyfus 1980) aligned to SFIA responsibility levels (SFIA Foundation). Verified 2026-06-05."@en ;
    rdfs:subClassOf org1:CompetencyLevel ;
    skos:definition "A high proficiency stage at which an individual works with broad autonomy, handles complex situations holistically, and guides others."@en .

org1:BackendDeveloper a owl:Class ;
    rdfs:label "Backend Developer"@en ;
    dcterms:source "Industry convention; no single formal standard governs this term (per O4SE trust-remediation sourcing directive 2026-06-05)."@en ;
    rdfs:subClassOf org1:TechnicalRole ;
    skos:definition "A technical role focused on server-side application logic, data, and services."@en .

org1:BeginnerLevel a owl:Class ;
    rdfs:label "Beginner Level"@en ;
    dcterms:source "Five-stage skill-proficiency scale (cf. Dreyfus & Dreyfus 1980) aligned to SFIA responsibility levels (SFIA Foundation). Verified 2026-06-05."@en ;
    rdfs:subClassOf org1:CompetencyLevel ;
    skos:definition "An early proficiency stage at which an individual applies guidelines to recurring situations with some situational awareness, working under routine supervision."@en .

org1:CTO a owl:Class ;
    rdfs:label "Chief Technology Officer"@en ;
    dcterms:source "Industry convention; no single formal standard governs this term (per O4SE trust-remediation sourcing directive 2026-06-05)."@en ;
    rdfs:subClassOf org1:ManagementRole ;
    skos:definition "An executive role (Chief Technology Officer) responsible for an organization's overall technology strategy and direction."@en .

org1:CloudSkill a owl:Class ;
