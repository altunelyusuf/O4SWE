    rdfs:comment "Knowledge area covering test levels, techniques, and management"@en ;
    rdfs:subClassOf swebok:KnowledgeArea ;
    skos:definition "A SWEBOK knowledge area covering test levels, techniques, and test management."@en .

swebok:SystemTesting a owl:Class ;
    rdfs:label "System Testing"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017, Systems and software engineering — Vocabulary (SEVOCAB); cross-referenced with ISO/IEC/IEEE 29119 Software Testing and the SWEBOK Guide Software Testing KA. Verified authority 2026-06-05; definitions paraphrased from the standard's framework."@en ;
    rdfs:subClassOf swebok:TestLevel ;
    skos:definition "Testing conducted on a complete, integrated system to evaluate its compliance with specified requirements."@en .

swebok:TeamManagement a owl:Class ;
    rdfs:label "Team Management"@en ;
    rdfs:subClassOf o4se:ManagementProcess ;
    skos:definition "Managing and coordinating development teams"@en .

swebok:UnitConstruction a owl:Class ;
    rdfs:label "Unit Construction"@en ;
    rdfs:subClassOf o4se:Implementation ;
    skos:definition "Building individual software units or components"@en .

swebok:UnitTesting a owl:Class ;
    rdfs:label "Unit Testing"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017, Systems and software engineering — Vocabulary (SEVOCAB); cross-referenced with ISO/IEC/IEEE 29119 Software Testing and the SWEBOK Guide Software Testing KA. Verified authority 2026-06-05; definitions paraphrased from the standard's framework."@en ;
    rdfs:subClassOf swebok:TestLevel ;
    skos:definition "The testing of individual software units or groups of related units in isolation from the rest of the system."@en .

swebok:VersionControl a owl:Class ;
    rdfs:label "Version Control"@en ;
    rdfs:subClassOf o4se:SupportProcess ;
    skos:definition "Managing changes to documents, code, and other artifacts"@en .

swebok:WhiteBoxTesting a owl:Class ;
    rdfs:label "White Box Testing"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017, Systems and software engineering — Vocabulary (SEVOCAB); cross-referenced with ISO/IEC/IEEE 29119 Software Testing and the SWEBOK Guide Software Testing KA. Verified authority 2026-06-05; definitions paraphrased from the standard's framework."@en ;
    rdfs:subClassOf swebok:TestTechnique ;
    skos:definition "Testing that derives test cases from knowledge of a component's internal structure and implementation; also termed structural or glass-box testing."@en .

swebok:belongsToKnowledgeArea a owl:ObjectProperty ;
    rdfs:label "belongs to knowledge area"@en ;
    dcterms:source "SWEBOK Guide v3 (ISO/IEC TR 19759)."@en ;
    rdfs:domain o4se:Activity ;
    rdfs:range swebok:KnowledgeArea ;
    skos:definition "Relates an activity to the SWEBOK knowledge area to which it belongs."@en .

swebok:followsDesignPrinciple a owl:ObjectProperty ;
    rdfs:label "follows design principle"@en ;
    dcterms:source "SWEBOK Guide v3 (ISO/IEC TR 19759)."@en ;
    rdfs:domain swebok:ArchitecturalDesign ;
    rdfs:range swebok:DesignPrinciple ;
    skos:definition "Relates an architectural design to a design principle it follows."@en .

swebok:hasQualityCharacteristic a owl:ObjectProperty ;
    rdfs:label "has quality characteristic"@en ;
    dcterms:source "ISO/IEC 25010 product-quality model."@en ;
    rdfs:domain o4se:SoftwareSystem ;
    rdfs:range swebok:QualityCharacteristic ;
    skos:definition "Relates a software system to a quality characteristic it exhibits."@en .

swebok:hasTestLevel a owl:ObjectProperty ;
    rdfs:label "has test level"@en ;
    dcterms:source "ISO/IEC/IEEE 29119 software testing."@en ;
    rdfs:domain o4se:TestCase ;
    rdfs:range swebok:TestLevel ;
    skos:definition "Relates a test case to its test level (e.g., unit, integration, system)."@en .

swebok:implementsPattern a owl:ObjectProperty ;
    rdfs:label "implements pattern"@en ;
    dcterms:source "Gamma, Helm, Johnson & Vlissides (GoF), Design Patterns."@en ;
    rdfs:domain o4se:SourceCode ;
    rdfs:range swebok:DesignPattern ;
    skos:definition "Relates source code to a design pattern it implements."@en .

swebok:relatedToKnowledgeArea a owl:ObjectProperty ;
    rdfs:label "related to knowledge area"@en ;
    dcterms:source "SWEBOK Guide v3 (ISO/IEC TR 19759)."@en ;
    rdfs:range swebok:KnowledgeArea ;
    skos:definition "Relates an entity to a SWEBOK knowledge area to which it is related."@en .

swebok:usesTestTechnique a owl:ObjectProperty ;
    rdfs:label "uses test technique"@en ;
    dcterms:source "ISO/IEC/IEEE 29119 software testing."@en ;
    rdfs:domain o4se:Testing ;
    rdfs:range swebok:TestTechnique ;
    skos:definition "Relates a testing activity to a test technique it uses."@en .

o4se:Application a owl:Class ;
    rdfs:label "Application"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017, Systems and software engineering — Vocabulary (SEVOCAB). Verified 2026-06-05."@en ;
    rdfs:subClassOf o4se:Software ;
    skos:definition "Software comprising a program or set of programs designed to perform tasks for end users."@en .

o4se:DesignDocument a owl:Class ;
    rdfs:label "Design Document"@en ;
    dcterms:source "ISO/IEC/IEEE 24765:2017, Systems and software engineering — Vocabulary (SEVOCAB). Verified 2026-06-05."@en ;
    rdfs:subClassOf o4se:Artifact ;
    skos:definition "An artifact that records the design of a system or component."@en .

o4se:NonFunctionalRequirement a owl:Class ;
    rdfs:label "Non-Functional Requirement"@en ;
    dcterms:source "ISO/IEC/IEEE 29148:2018 Requirements engineering; cross-referenced ISO/IEC/IEEE 24765:2017 (SEVOCAB). Verified 2026-06-05."@en ;
    rdfs:subClassOf o4se:Requirement ;
    skos:definition "A requirement that specifies a quality attribute or constraint on a system rather than a specific behaviour — e.g. performance, security, usability (also termed a quality requirement)."@en .

o4se:SoftwareEngineering a owl:Class ;
    rdfs:label "Software Engineering"@en ;
    rdfs:comment "The application of a systematic, disciplined, quantifiable approach to the development, operation, and maintenance of software"@en ;
    skos:definition "Engineering discipline concerned with all aspects of software production from early stages to maintenance"@en .

o4se:TraditionalMethodology a owl:Class ;
    rdfs:label "Traditional Methodology"@en ;
    dcterms:source "ISO/IEC/IEEE 12207:2017, Systems and software engineering — Software life cycle processes."@en ;
    rdfs:subClassOf o4se:Methodology ;
    skos:definition "A methodology following a sequential, plan-driven lifecycle (e.g., waterfall), in contrast to iterative or agile approaches."@en .

arch:ArchitectureStyle a owl:Class ;
    rdfs:label "Architecture Style"@en ;
    dcterms:source "Grounded in the O4SE source ontology's existing rdfs:comment for this class (internal authority), normalised to genus-differentia form during O4SE v1.0.2 trust remediation. SWEBOK knowledge-area definitions additionally reflect the IEEE SWEBOK Guide."@en ;
    rdfs:comment "Set of design rules and constraints"@en ;
    skos:definition "A named set of design rules and constraints that govern the organisation of a system's architecture."@en .

arch:BackendLayer a owl:Class ;
    rdfs:label "Backend Layer"@en ;
    rdfs:subClassOf arch:BusinessLogicLayer ;
    skos:definition "Server-side processing"@en .

arch:BusinessLogicLayer a owl:Class ;
    rdfs:label "Business Logic Layer"@en ;
    rdfs:subClassOf arch:ApplicationLayer ;
    skos:definition "Core business rules and processing"@en .

arch:MicroservicesArchitecture a owl:Class ;
    rdfs:label "Microservices Architecture"@en ;
    rdfs:subClassOf arch:ArchitecturePattern ;
    skos:definition "Application as suite of small services"@en .

arch:NTierArchitecture a owl:Class ;
    rdfs:label "N-Tier Architecture"@en ;
    rdfs:subClassOf arch:ClientServerArchitecture ;
    skos:definition "Multiple logical and physical tiers"@en .

arch:PresentationLayer a owl:Class ;
    rdfs:label "Presentation Layer"@en ;
    rdfs:subClassOf arch:ApplicationLayer ;
    skos:definition "User interface and interaction"@en .

arch:ProofOfStake a owl:Class ;
    rdfs:label "Proof of Stake"@en ;
    dcterms:source "Proof-of-Stake consensus literature (e.g., Ethereum proof-of-stake specification)."@en ;
    rdfs:subClassOf arch:ConsensusAlgorithm ;
    skos:definition "A blockchain consensus mechanism in which validators are selected to create blocks in proportion to the stake (cryptocurrency) they commit as collateral."@en .

arch:ProofOfWork a owl:Class ;
    rdfs:label "Proof of Work"@en ;
    dcterms:source "Nakamoto, S. (2008), 'Bitcoin: A Peer-to-Peer Electronic Cash System'."@en ;
    rdfs:subClassOf arch:ConsensusAlgorithm ;
    skos:definition "A blockchain consensus mechanism in which participants compete to solve a computationally expensive puzzle to validate transactions and append blocks."@en .

cmmi:Level5_Optimizing a owl:Class ;
    rdfs:label "Level 5 - Optimizing"@en ;
    rdfs:subClassOf cmmi:MaturityLevel ;
    skos:definition "Focus on continuous process improvement"@en .

data:ColumnFamilyDatabase a owl:Class ;
    rdfs:label "Column-Family Database"@en ;
    rdfs:subClassOf data:NoSQLDatabase ;
    skos:definition "Data stored in column families"@en .

data:DatabaseSystem a owl:Class ;
    rdfs:label "Database System"@en ;
    dcterms:source "Grounded in the O4SE source ontology's existing rdfs:comment for this class (internal authority), normalised to genus-differentia form during O4SE v1.0.2 trust remediation. SWEBOK knowledge-area definitions additionally reflect the IEEE SWEBOK Guide."@en ;
    rdfs:comment "Software for managing databases"@en ;
    rdfs:subClassOf o4se:SystemSoftware ;
