tax:D25_T15_C6 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T15 ;
    skos:definition "A fact kept about a requirement besides its statement, such as its identity, owner, reason, source, priority, risk, state and how it will be verified."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.15.6" ;
    skos:prefLabel "Requirement attribute"@en ;
    skos:related tax:Area_BusinessAnalysis,
        tax:Area_TechnicalAnalysis .

tax:D25_T15_C7 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T15 ;
    skos:definition "A property that a whole collection of requirements has or lacks, and that no single requirement can show, such as whether together they leave nothing out, contradict nothing and can be met."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.15.7" ;
    skos:prefLabel "Requirement set property"@en ;
    skos:related tax:Area_BusinessAnalysis,
        tax:Area_TechnicalAnalysis .

tax:D25_T15_C8 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T15 ;
    skos:definition "A rule for writing a requirement so that it is unambiguous, singular, measurable and testable, so that two readers cannot understand it differently."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.15.8" ;
    skos:prefLabel "Requirement wording rule"@en ;
    skos:related tax:Area_BusinessAnalysis,
        tax:Area_TechnicalAnalysis .

tax:D25_T15_C9 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T15 ;
    skos:definition "The decision, made when the requirement is written, of how it will later be shown to be met, by inspection, analysis, demonstration or test."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.15.9" ;
    skos:prefLabel "Requirement verification approach"@en ;
    skos:related tax:Area_BusinessAnalysis,
        tax:Area_TechnicalAnalysis,
        tax:Area_TransitionAndRelease .

tax:D25_T16_C1 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T16 ;
    skos:definition "A description, from the point of view of the user and operator, of how the product is expected to be used, in what surroundings and by whom."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.16.1" ;
    skos:prefLabel "Operational concept"@en ;
    skos:related tax:Area_BusinessAnalysis,
        tax:Area_TechnicalAnalysis .

tax:D25_T16_C2 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T16 ;
    skos:definition "A description of the organization's intended way of working with the solution, used to understand stakeholder intentions before they are formal requirements."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.16.2" ;
    skos:prefLabel "Concept at organization level"@en ;
    skos:related tax:Area_BusinessAnalysis .

tax:D25_T16_C3 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T16 ;
    skos:definition "A story of use stepping through who does what with the product to reach a goal, including the unhappy paths; it is both a source of requirements and a way to validate them."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.16.3" ;
    skos:prefLabel "Operational scenario"@en ;
    skos:related tax:Area_BusinessAnalysis,
        tax:Area_TechnicalAnalysis,
        tax:Area_TransitionAndRelease .

tax:D25_T16_C4 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T16 ;
    skos:definition "A named goal that a user can achieve with the product, with the main way and the variations by which it is achieved."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.16.4" ;
    skos:prefLabel "Use case"@en ;
    skos:related tax:Area_BusinessAnalysis,
        tax:Area_TechnicalAnalysis .

tax:D25_T16_C5 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T16 ;
    skos:definition "A distinct way the product is in use, such as normal, degraded, maintenance or training, each with its own behaviour and constraints."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.16.5" ;
    skos:prefLabel "Operational mode"@en ;
    skos:related tax:Area_BusinessAnalysis,
        tax:Area_TechnicalAnalysis,
        tax:Area_TransitionAndRelease .

tax:D25_T16_C6 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T16 ;
    skos:definition "The line between the product and everything it deals with, and the description of what is on the other side."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.16.6" ;
    skos:prefLabel "System boundary and context"@en ;
    skos:related tax:Area_BusinessAnalysis,
        tax:Area_DomainEngineering,
        tax:Area_TechnicalAnalysis .

tax:D25_T16_C7 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T16 ;
    skos:definition "The recognition that the product has different stakeholders and demands at different stages of its life, from idea to retirement."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.16.7" ;
    skos:prefLabel "Life cycle stage view"@en ;
    skos:related tax:Area_BusinessAnalysis,
        tax:Area_Disposal .

tax:D25_T17_C1 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T17 ;
    skos:definition "Breaking the required behaviour into smaller functions that together do the whole, so that each can be assigned, analysed and checked."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.17.1" ;
    skos:prefLabel "Functional decomposition"@en ;
    skos:related tax:Area_TechnicalAnalysis .

tax:D25_T17_C2 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T17 ;
    skos:definition "How functions follow one another and which states the product passes through, described so that gaps and conflicts show up."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.17.2" ;
    skos:prefLabel "Functional flow and state"@en ;
    skos:related tax:Area_TechnicalAnalysis .

tax:D25_T17_C3 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T17 ;
    skos:definition "A way in which a function can fail or be misused, found early by asking what could go wrong with each function."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.17.3" ;
    skos:prefLabel "Dysfunction"@en ;
    skos:related tax:Area_TechnicalAnalysis .

tax:D25_T17_C4 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T17 ;
    skos:definition "The arrangement of the solution by what its parts are for, independent of how they will be realized."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.17.4" ;
    skos:prefLabel "Logical structure"@en ;
    skos:related tax:Area_TechnicalAnalysis .

tax:D25_T17_C5 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T17 ;
    skos:definition "The arrangement of the solution by what its parts are made of and where they run, derived from and traced to the logical structure."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.17.5" ;
    skos:prefLabel "Physical structure"@en ;
    skos:related tax:Area_IntegrationAndBuild,
        tax:Area_TechnicalAnalysis .

tax:D25_T17_C6 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T17 ;
    skos:definition "Studying safety, reliability, security or resilience as properties of the entire solution, since they cannot be read off any single part."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.17.6" ;
    skos:prefLabel "Whole-system property analysis"@en ;
    skos:related tax:Area_TechnicalAnalysis .

tax:D25_T17_C7 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T17 ;
    skos:definition "Bringing the designs of different disciplines into one consistent solution, and preparing the later combination of their parts."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.17.7" ;
    skos:prefLabel "Design integration across disciplines"@en ;
    skos:related tax:Area_IntegrationAndBuild,
        tax:Area_TechnicalAnalysis .

tax:D25_T18_C1 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced. Read for this concept: SEI presentation \"Introduction to Software Product Lines\" (2014, approved for public release, unlimited distribution), which names adoption approaches and the practice areas scoping, business case, organization and funding; wording is this package's own."@en ;
    skos:broader tax:D25_T18 ;
    skos:definition "The route by which an organization moves from building products one at a time to building them from shared assets: making the assets first, extracting them from products that already exist, or growing them in steps."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.18.1" ;
    skos:prefLabel "Adoption path"@en ;
    skos:related tax:Area_ApplicationEngineering,
        tax:Area_DomainEngineering .

tax:D25_T18_C2 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced. Read for this concept: SEI presentation \"Introduction to Software Product Lines\" (2014, approved for public release, unlimited distribution), which names adoption approaches and the practice areas scoping, business case, organization and funding; wording is this package's own."@en ;
    skos:broader tax:D25_T18 ;
    skos:definition "The deliberate widening or narrowing of what the family covers as markets and assets change; when assets are made first the scope is mostly fixed in advance, when they are extracted it grows with experience."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.18.2" ;
    skos:prefLabel "Scope evolution"@en ;
    skos:related tax:Area_DomainEngineering .

tax:D25_T18_C3 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced. Read for this concept: SEI presentation \"Introduction to Software Product Lines\" (2014, approved for public release, unlimited distribution), which names adoption approaches and the practice areas scoping, business case, organization and funding; wording is this package's own."@en ;
    skos:broader tax:D25_T18 ;
    skos:definition "The argument, in cost and benefit over the life of the family, that shared assets will repay more than building each product alone, counting the making and keeping of the assets."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.18.3" ;
    skos:prefLabel "Family business case"@en ;
    skos:related tax:Area_ApplicationEngineering,
        tax:Area_BusinessAnalysis,
        tax:Area_DomainEngineering .

tax:D25_T18_C4 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced. Read for this concept: SEI presentation \"Introduction to Software Product Lines\" (2014, approved for public release, unlimited distribution), which names adoption approaches and the practice areas scoping, business case, organization and funding; wording is this package's own."@en ;
    skos:broader tax:D25_T18 ;
    skos:definition "Who owns the shared assets, who builds products from them, and how the two groups are kept in step."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.18.4" ;
    skos:prefLabel "Family organization"@en ;
    skos:related tax:Area_ApplicationEngineering,
        tax:Area_DomainEngineering .

tax:D25_T18_C5 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced. Read for this concept: SEI presentation \"Introduction to Software Product Lines\" (2014, approved for public release, unlimited distribution), which names adoption approaches and the practice areas scoping, business case, organization and funding; wording is this package's own."@en ;
    skos:broader tax:D25_T18 ;
    skos:definition "How the cost of making and keeping shared assets is paid: from a central budget, by charges to the products that use them, or by contributions from product teams."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.18.5" ;
    skos:prefLabel "Asset funding"@en ;
    skos:related tax:Area_DomainEngineering .

tax:D25_T18_C6 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced. This package's own judgement; no open work read states it (stated plainly), drawn from the product line material already in the corpus."@en ;
    skos:broader tax:D25_T18 ;
    skos:definition "The decisions about what enters, changes or leaves the shared assets, who takes them, and how conflicting demands from several products are settled."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.18.6" ;
    skos:prefLabel "Asset governance"@en ;
    skos:related tax:Area_ApplicationEngineering,
        tax:Area_DomainEngineering .

tax:D25_T18_C7 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced. This package's own judgement; no open work read states it (stated plainly), drawn from the product line material already in the corpus."@en ;
    skos:broader tax:D25_T18 ;
    skos:definition "A periodic look at the products and the planned products of the family against its scope, used to decide which to start, continue or withdraw."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.18.7" ;
    skos:prefLabel "Family portfolio review"@en ;
    skos:related tax:Area_ApplicationEngineering,
        tax:Area_Disposal,
        tax:Area_DomainEngineering .

tax:D25_T19_C1 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced. Read for this concept: DORA site, delivery performance measures (CC BY 4.0, Google LLC); wording is this package's own."@en ;
    skos:broader tax:D25_T19 ;
    skos:definition "How quickly changes reach production, read as the time from a committed change to its running in production and as how often releases happen."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.19.1" ;
    skos:prefLabel "Throughput measure"@en ;
    skos:related tax:Area_IntegrationAndBuild,
        tax:Area_TransitionAndRelease .

tax:D25_T19_C10 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced. Read for this concept: Google SRE book and workbook, chapters on postmortem culture (CC BY-NC-ND 4.0); read only, nothing of the text or structure is taken, wording is this package's own."@en ;
    skos:broader tax:D25_T19 ;
    skos:definition "Pooling the reviews of many incidents to see recurring causes, detection and recovery times and extent of impact, so that reliability work goes where it matters."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.19.10" ;
    skos:prefLabel "Incident trend analysis"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T19_C11 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced. Read for this concept: Google SRE book and workbook, chapters on postmortem culture (CC BY-NC-ND 4.0); read only, nothing of the text or structure is taken, wording is this package's own."@en ;
    skos:broader tax:D25_T19 ;
    skos:definition "Practising recovery on purpose to check that the planned way back really works and that people know it."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.19.11" ;
    skos:prefLabel "Recovery rehearsal"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T19_C2 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced. Read for this concept: DORA site, delivery performance measures (CC BY 4.0, Google LLC); wording is this package's own."@en ;
    skos:broader tax:D25_T19 ;
    skos:definition "How often a release needs urgent repair afterwards and how long recovery takes; read together with throughput so that speed is not bought with breakage."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.19.2" ;
    skos:prefLabel "Stability measure"@en ;
    skos:related tax:Area_IntegrationAndBuild,
        tax:Area_TransitionAndRelease .

tax:D25_T19_C3 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced. Read for this concept: OWASP DevSecOps Guideline, pipeline security activities (CC BY-SA 4.0); wording is this package's own."@en ;
    skos:broader tax:D25_T19 ;
    skos:definition "Describing machines, networks and settings in versioned files from which environments are created and changed, so that they can be reviewed, repeated and rebuilt like software."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.19.3" ;
    skos:prefLabel "Environment as code"@en ;
    skos:related tax:Area_IntegrationAndBuild,
        tax:Area_TransitionAndRelease .

tax:D25_T19_C4 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced. Read for this concept: OWASP DevSecOps Guideline, pipeline security activities (CC BY-SA 4.0); wording is this package's own."@en ;
    skos:broader tax:D25_T19 ;
    skos:definition "Keeping credentials and keys out of source and artifacts, giving them to builds and runs only when needed, and detecting leaks."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.19.4" ;
    skos:prefLabel "Secret handling"@en ;
    skos:related tax:Area_IntegrationAndBuild,
        tax:Area_TransitionAndRelease .

tax:D25_T19_C5 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced. Read for this concept: OWASP DevSecOps Guideline, pipeline security activities (CC BY-SA 4.0); wording is this package's own."@en ;
    skos:broader tax:D25_T19 ;
    skos:definition "Placing code analysis, dependency checks, configuration scanning and dynamic testing as stages of the delivery flow, each with a stated pass criterion."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.19.5" ;
    skos:prefLabel "Security checks in the flow"@en ;
    skos:related tax:Area_IntegrationAndBuild,
        tax:Area_TransitionAndRelease .

tax:D25_T19_C6 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced. Read for this concept: NIST SP 800-218 Secure Software Development Framework v1.1 (not subject to copyright in the United States); wording is this package's own."@en ;
    skos:broader tax:D25_T19 ;
    skos:definition "Releasing software whose initial configuration is the safe one, so that loosening it is a deliberate act of the user."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.19.6" ;
    skos:prefLabel "Secure default configuration"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T19_C7 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced. Read for this concept: NIST SP 800-218 Secure Software Development Framework v1.1 (not subject to copyright in the United States); wording is this package's own."@en ;
    skos:broader tax:D25_T19 ;
    skos:definition "Finding, assessing, ranking and fixing weaknesses in released software on an ongoing basis, and analysing their causes so that the same kind does not return."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.19.7" ;
    skos:prefLabel "Vulnerability response"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T19_C8 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced. Read for this concept: Google SRE book and workbook, chapters on postmortem culture (CC BY-NC-ND 4.0); read only, nothing of the text or structure is taken, wording is this package's own."@en ;
    skos:broader tax:D25_T19 ;
    skos:definition "Examining an incident to learn what in the system and its information led to it, on the assumption that people acted in good faith; the aim is a better system, not a culprit."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.19.8" ;
    skos:prefLabel "Blameless review"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T19_C9 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced. Read for this concept: Google SRE book and workbook, chapters on postmortem culture (CC BY-NC-ND 4.0); read only, nothing of the text or structure is taken, wording is this package's own."@en ;
    skos:broader tax:D25_T19 ;
    skos:definition "A change agreed after an incident, with an end state that can be tested and a purpose (prevent, detect, lessen or repair), preferring changes to systems over appeals to behaviour."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.19.9" ;
    skos:prefLabel "Follow-up action"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T1_C1 a skos:Concept ;
