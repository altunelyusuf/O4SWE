    skos:broader tax:D25_T15 ;
    skos:definition "A requirement on what crosses the boundary between the solution and something outside it, or between two parts of it."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.15.5" ;
    skos:prefLabel "Interface requirement"@en ;
    skos:related tax:Area_BusinessAnalysis,
        tax:Area_IntegrationAndBuild,
