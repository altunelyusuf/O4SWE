    skos:broader tax:D25_T9 ;
    skos:definition "The transformation of sources and dependencies into runnable artifacts by a defined, repeatable procedure."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.9.4" ;
    skos:prefLabel "Build"@en ;
    skos:related tax:Area_IntegrationAndBuild .

tax:D25_T9_C5 a skos:Concept ;
