tax:D25_T10_C1 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T10 ;
    skos:definition "An ordered, automated sequence of stages that carries a change from source toward a deliverable and records what happened."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.10.1" ;
    skos:prefLabel "Delivery pipeline"@en ;
    skos:related tax:Area_IntegrationAndBuild,
        tax:Area_TransitionAndRelease .

tax:D25_T10_C10 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T10 ;
    skos:definition "Working practice in which those who build and those who run software share responsibility for its whole life."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.10.10" ;
    skos:prefLabel "Operations collaboration"@en ;
    skos:related tax:Area_IntegrationAndBuild,
        tax:Area_TransitionAndRelease .

tax:D25_T10_C2 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T10 ;
    skos:definition "A point in a pipeline at which a change must meet stated conditions before it moves on."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.10.2" ;
    skos:prefLabel "Stage gate"@en ;
    skos:related tax:Area_IntegrationAndBuild,
        tax:Area_TransitionAndRelease .

tax:D25_T10_C3 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T10 ;
    skos:definition "Keeping the description of a pipeline in versioned, reviewable files like any other source."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.10.3" ;
    skos:prefLabel "Pipeline definition as code"@en ;
    skos:related tax:Area_IntegrationAndBuild .

tax:D25_T10_C4 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T10 ;
    skos:definition "The delay between making a change and learning whether it broke anything; the shorter it is, the cheaper a mistake."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.10.4" ;
    skos:prefLabel "Feedback time"@en ;
    skos:related tax:Area_IntegrationAndBuild .

tax:D25_T10_C5 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T10 ;
    skos:definition "The habit of merging small changes into a shared line of work often, with automatic checks on each."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.10.5" ;
    skos:prefLabel "Frequent integration"@en ;
    skos:related tax:Area_IntegrationAndBuild .

tax:D25_T10_C6 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T10 ;
    skos:definition "The discipline of keeping the main line of work in a condition from which a release could be made at any time."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.10.6" ;
    skos:prefLabel "Always-releasable state"@en ;
    skos:related tax:Area_IntegrationAndBuild,
        tax:Area_TransitionAndRelease .

tax:D25_T10_C7 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T10 ;
    skos:definition "The practice of releasing every change that passes its checks without a separate manual step."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.10.7" ;
    skos:prefLabel "Automatic release"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T10_C8 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T10 ;
    skos:definition "Assurance that the inputs, tools and steps that produce an artifact have not been altered or substituted."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.10.8" ;
    skos:prefLabel "Supply chain integrity"@en ;
    skos:related tax:Area_IntegrationAndBuild,
        tax:Area_TransitionAndRelease .

tax:D25_T10_C9 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T10 ;
    skos:definition "The ability to see what a pipeline did and why, from its records, without re-running it."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.10.9" ;
    skos:prefLabel "Pipeline observability"@en ;
    skos:related tax:Area_IntegrationAndBuild,
        tax:Area_TransitionAndRelease .

tax:D25_T11_C1 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T11 ;
    skos:definition "A version proposed for release, frozen so that the evidence gathered about it applies to what is released."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.11.1" ;
    skos:prefLabel "Release candidate"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T11_C10 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T11 ;
    skos:definition "The transfer of responsibility for a running result from those who built it to those who will run it, with what they need to do so."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.11.10" ;
    skos:prefLabel "Operational handover"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T11_C11 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T11 ;
    skos:definition "The stakeholder's confirmation that the result meets what was agreed and may be taken into use."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.11.11" ;
    skos:prefLabel "Customer acceptance"@en ;
    skos:related tax:Area_BusinessAnalysis,
        tax:Area_TransitionAndRelease .

tax:D25_T11_C12 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T11 ;
    skos:definition "Observation after release to confirm that the result behaves as intended in real use."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.11.12" ;
    skos:prefLabel "Post-release check"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T11_C13 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T11 ;
    skos:definition "The plan for moving a product into use: the kind of move, how success is judged, how often it recurs, how disruption and risk are limited and what is done if it fails."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.11.13" ;
    skos:prefLabel "Transition strategy"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T11_C14 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T11 ;
    skos:definition "Making the place the product will run in ready for it: sites, networks, enabling services and the people who will operate it."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.11.14" ;
    skos:prefLabel "Target environment preparation"@en ;
    skos:related tax:Area_IntegrationAndBuild,
        tax:Area_TransitionAndRelease .

tax:D25_T11_C15 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T11 ;
    skos:definition "A release made outside the normal rhythm to remove a harmful fault or a security weakness, with a lighter path that still leaves a record."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.11.15" ;
    skos:prefLabel "Emergency change"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T11_C16 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T11 ;
    skos:definition "The prepared way back to the last working state when a move into use fails, tested before it is needed."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.11.16" ;
    skos:prefLabel "Return path"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T11_C17 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T11 ;
    skos:definition "A limit on how a product can be moved into use that must be given back to requirements, architecture and design, because the design decides it."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.11.17" ;
    skos:prefLabel "Transition constraint"@en ;
    skos:related tax:Area_TechnicalAnalysis,
        tax:Area_TransitionAndRelease .

tax:D25_T11_C18 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T11 ;
    skos:definition "An unexpected result observed while moving a product into use, recorded so that the next move starts from it."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.11.18" ;
    skos:prefLabel "Transition anomaly"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T11_C2 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T11 ;
    skos:definition "The state in which stated conditions for releasing, such as evidence, approvals and preparedness, have been met."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.11.2" ;
    skos:prefLabel "Release readiness"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T11_C3 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T11 ;
    skos:definition "The placing of software into an environment where it will run and making it ready to do so."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.11.3" ;
    skos:prefLabel "Deployment"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T11_C4 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T11 ;
    skos:definition "The way a release reaches its users, for example all at once, in stages or to a small group first, chosen to limit harm."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.11.4" ;
    skos:prefLabel "Exposure strategy"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T11_C5 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T11 ;
    skos:definition "The prepared means of returning to a known good state if a release goes wrong."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.11.5" ;
    skos:prefLabel "Recovery path"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T11_C6 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T11 ;
    skos:definition "The point at which work moves from the old way of working, or the old system, to the new one."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.11.6" ;
    skos:prefLabel "Cutover"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T11_C7 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T11 ;
    skos:definition "The movement and conversion of existing data into the form the new system needs, with checks that nothing is lost or changed."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.11.7" ;
    skos:prefLabel "Data migration"@en ;
    skos:related tax:Area_Disposal,
        tax:Area_TransitionAndRelease .

tax:D25_T11_C8 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T11 ;
    skos:definition "The preparedness of the people who will use and run the result, through training, guidance and support."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.11.8" ;
    skos:prefLabel "User and operator readiness"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T11_C9 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T11 ;
    skos:definition "The record of what was released, when, to where, on what evidence and by whose decision."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.11.9" ;
    skos:prefLabel "Release record"@en ;
    skos:related tax:Area_TransitionAndRelease .

tax:D25_T12_C1 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T12 ;
    skos:definition "The reasoned decision to stop providing a product, a variant or a capability, with who decided and why."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.12.1" ;
    skos:prefLabel "Retirement decision"@en ;
    skos:related tax:Area_Disposal .

tax:D25_T12_C10 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T12 ;
    skos:definition "A limit on how a product may be ended, such as data ownership, legal retention or security, that must be given to requirements, architecture and design while the product is still being made."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.12.10" ;
    skos:prefLabel "Disposal constraint"@en ;
    skos:related tax:Area_Disposal,
        tax:Area_TechnicalAnalysis .

tax:D25_T12_C11 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T12 ;
    skos:definition "A tool, facility or service needed only to end the product, such as an archive or a secure erasure service, planned and checked before the ending begins."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.12.11" ;
    skos:prefLabel "Disposal enabling service"@en ;
    skos:related tax:Area_Disposal .

tax:D25_T12_C12 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T12 ;
    skos:definition "Telling everyone who depends on the product, in good time, what will end, when, and what replaces it."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.12.12" ;
    skos:prefLabel "Retirement notification"@en ;
    skos:related tax:Area_Disposal,
        tax:Area_TransitionAndRelease .

tax:D25_T12_C13 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T12 ;
    skos:definition "The ways an element can leave service: reuse elsewhere, archiving, reconditioning, recycling or destruction, chosen by the value it still has and the risk of keeping it."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.12.13" ;
    skos:prefLabel "Disposition option"@en ;
    skos:related tax:Area_Disposal .

tax:D25_T12_C14 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T12 ;
    skos:definition "Making sure that what was retired cannot return to use by accident, for example by removing keys, licences, access and copies."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.12.14" ;
    skos:prefLabel "Re-entry prevention"@en ;
    skos:related tax:Area_Disposal .

tax:D25_T12_C15 a skos:Concept ;
    dcterms:rights "Original formulation of this package, offered under the terms of the ontology (CC BY 4.0). It reproduces no text, title or structure of the works that informed it."@en ;
    dcterms:source "Own formulation of this package (2026-10-13), informed by the works named at the domain; no text, title or structure of them is reproduced."@en ;
    skos:broader tax:D25_T12 ;
    skos:definition "Retiring only the elements affected by a change while the rest continues in use, which needs the boundary between them to be known."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
