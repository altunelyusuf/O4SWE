    skos:broader tax:D25_T9 ;
    skos:definition "A part that another part needs in order to be built or to run, whether made in-house or obtained elsewhere."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.9.6" ;
    skos:prefLabel "Dependency"@en ;
    skos:related tax:Area_IntegrationAndBuild .

tax:D25_T9_C7 a skos:Concept ;
