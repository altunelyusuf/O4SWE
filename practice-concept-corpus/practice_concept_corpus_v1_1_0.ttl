    skos:broader tax:D25_T9 ;
    skos:definition "A defect in which two parts that each work alone fail together because they hold different understandings of their boundary."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.9.9" ;
    skos:prefLabel "Interface mismatch"@en ;
    skos:related tax:Area_IntegrationAndBuild .

<http://example.org/practice-concept-corpus> a owl:Ontology ;
    dcterms:created "2026-10-13" ;
    dcterms:creator "Yusuf Altunel" ;
    dcterms:description "An own, original formulation of practice concepts for seven areas of the software life cycle (domain engineering, application engineering, business analysis, technical analysis, integration and build, transition and release, disposal), grouped by meaning into themes. Exported from the domain 25 of the agentic-sdlc ontology, release 0.99.0 (A-Box 2.11.0). It reproduces no text, title or structure of any copyrighted work."@en ;
    dcterms:identifier "practice_concept_corpus_v1_1_0" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "© 2026 Yusuf Altunel, CC BY 4.0"@en ;
    dcterms:title "Practice Concept Corpus"@en ;
    owl:versionIRI <http://example.org/practice-concept-corpus/1.1.0> ;
    owl:versionInfo "1.1.0" .

