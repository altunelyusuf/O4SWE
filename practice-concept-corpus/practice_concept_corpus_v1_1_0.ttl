    skos:broader tax:D25_T9 ;
    skos:definition "A build that gives the same result from the same inputs, wherever and whenever it is run."@en ;
    skos:inScheme tax:PracticeConceptCorpusScheme ;
    skos:notation "25.9.5" ;
    skos:prefLabel "Repeatable build"@en ;
    skos:related tax:Area_IntegrationAndBuild .

tax:D25_T9_C6 a skos:Concept ;
